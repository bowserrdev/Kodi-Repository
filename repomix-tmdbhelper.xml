    def on_action(self):
        x = self.list_control.getSelectedPosition()
        self.routes[x].menu()
        self.update_winprop()

    def on_reset(self):
        value = self.routes_dict['reset'].menu()
        self.update_winprop()
        return value

    def on_save(self):
