            for i in self.presorted_items
        ])
        items_a = [i for i in items_a if i]
        items_z = [i for i in items_z if i]
        items_a = sorted(items_a, key=lambda x: x['next_episode_aired_at'], reverse=True)
        return items_a + items_z

