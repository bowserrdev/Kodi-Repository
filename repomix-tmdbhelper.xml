                'func': self.tmdb_imagepath.get_imagepath_origin
            }],
            'backdrop_path': [{
                'keys': [('art', 'fanart')],
                'func': self.tmdb_imagepath.get_imagepath_fanart
            }],
            'release_date': [{
                'keys': [('infolabels', 'premiered')]}, {
                'keys': [('infolabels', 'year')],
                'func': lambda v: int(v[0:4])
            }],
            'first_air_date': [{
                'keys': [('infolabels', 'premiered')]}, {
                'keys': [('infolabels', 'year')],
                'func': lambda v: int(v[0:4])
            }],
            'air_date': [{
                'keys': [('infolabels', 'premiered')]}, {
