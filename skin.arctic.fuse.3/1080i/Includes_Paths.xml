    <variable name="Path_Youtube_Query">
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),set) | ListItem.IsCollection] + !String.IsEmpty(ListItem.Set)">$VAR[Path_Encoded_Set]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),movie) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title]$INFO[ListItem.Year, ,] Movie</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),tvshow) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title]$INFO[ListItem.Year, ,]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),season) + !String.IsEmpty(ListItem.TVShowTitle)">$VAR[Path_Encoded_TVShowTitle]$INFO[ListItem.Season, Season ,]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),episode) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_TVShowTitle,, ]$VAR[Path_Encoded_Title]</value>
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),actor) | String.IsEqual(ListItem.Property(tmdb_type),person)] + !String.IsEmpty(ListItem.Label)">$VAR[Path_Encoded_Label]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),artist) + !String.IsEmpty(ListItem.AlbumArtist)">$VAR[Path_Encoded_AlbumArtist] Music</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),artist) + !String.IsEmpty(ListItem.Artist)">$VAR[Path_Encoded_Artist] Music</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),album) + !String.IsEmpty(ListItem.Album)">$VAR[Path_Encoded_AlbumArtist,, ]$VAR[Path_Encoded_Album] Music</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),song) + !String.IsEmpty(ListItem.Title) + !String.IsEmpty(ListItem.AlbumArtist)">$VAR[Path_Encoded_AlbumArtist,, ]$VAR[Path_Encoded_Title] Music</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),song) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Artist,, ]$VAR[Path_Encoded_Title] Music</value>
        <value condition="!String.IsEmpty(ListItem.TvShowTitle)">$VAR[Path_Encoded_TVShowTitle]</value>
        <value condition="!String.IsEmpty(ListItem.AlbumArtist)">$VAR[Path_Encoded_AlbumArtist]</value>
        <value condition="!String.IsEmpty(ListItem.Artist)">$VAR[Path_Encoded_Artist]</value>
        <value condition="!String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title]</value>
        <value condition="!String.IsEmpty(ListItem.Label)">$VAR[Path_Encoded_Label]</value>
    </variable>

