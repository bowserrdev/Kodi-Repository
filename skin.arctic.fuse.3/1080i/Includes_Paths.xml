        <value condition="String.IsEqual(Window.Property(FenLight.DBType),tvshow) | String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)">special://skin/extras/playlists/Null.xsp</value>
    </variable>

    <variable name="Path_VideoInfo_OnlineYear">
        <value condition="String.IsEmpty(Window.Property(FenLight.Year))">special://skin/extras/playlists/Null.xsp</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),movie)">plugin://plugin.video.fenlight/?mode=build_movie_list&amp;action=tmdb_movies_discover&amp;url=https%3A%2F%2Fapi.themoviedb.org%2F3%2Fdiscover%2Fmovie%3Fvote_count.gte%3D10%26sort_by%3Dpopularity.desc%26primary_release_year%3D$INFO[Window.Property(FenLight.Year)]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),tvshow) | String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)">plugin://plugin.video.fenlight/?mode=build_tvshow_list&amp;action=tmdb_tv_discover&amp;url=https%3A%2F%2Fapi.themoviedb.org%2F3%2Fdiscover%2Ftv%3Fvote_count.gte%3D10%26sort_by%3Dpopularity.desc%26first_air_date_year%3D$INFO[Window.Property(FenLight.Year)]</value>
    </variable>

    <variable name="Path_VideoInfo_OnlineStudio">
        <value condition="String.IsEmpty(Window(Home).Property(FenLight.ListItem.Studio.1.TMDb_ID))">special://skin/extras/playlists/Null.xsp</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),movie)">plugin://plugin.video.fenlight/?mode=build_movie_list&amp;action=tmdb_movies_discover&amp;url=https%3A%2F%2Fapi.themoviedb.org%2F3%2Fdiscover%2Fmovie%3Fsort_by%3Dpopularity.desc%26with_companies%3D$INFO[Window(Home).Property(FenLight.ListItem.Studio.1.TMDb_ID)]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),tvshow) | String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)">plugin://plugin.video.fenlight/?mode=build_tvshow_list&amp;action=tmdb_tv_discover&amp;url=https%3A%2F%2Fapi.themoviedb.org%2F3%2Fdiscover%2Ftv%3Fsort_by%3Dpopularity.desc%26with_networks%3D$INFO[Window(Home).Property(FenLight.ListItem.Studio.1.TMDb_ID)]</value>
    </variable>

    <variable name="Path_VideoInfo_OnlineRecommendations">
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),movie) + !String.IsEmpty(Window.Property(FenLight.TMDb_ID))">plugin://plugin.video.fenlight/?mode=build_movie_list&amp;action=tmdb_movies_recommendations&amp;key_id=$INFO[Window.Property(FenLight.TMDb_ID)]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),tvshow) + !String.IsEmpty(Window.Property(FenLight.TMDb_ID))">plugin://plugin.video.fenlight/?mode=build_tvshow_list&amp;action=tmdb_tv_recommendations&amp;key_id=$INFO[Window.Property(FenLight.TMDb_ID)]</value>
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)] + !String.IsEmpty(Window.Property(FenLight.TMDb_ID))">plugin://plugin.video.fenlight/?mode=build_tvshow_list&amp;action=tmdb_tv_recommendations&amp;key_id=$INFO[Window.Property(FenLight.TMDb_ID)]</value>
        <value>special://skin/extras/playlists/Null.xsp</value>
    </variable>

