<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <variable name="Path_VideoInfo_LocalSets">
        <value condition="String.IsEmpty(ListItem.SetID)">special://skin/extras/playlists/Null.xsp</value>
        <value>$INFO[ListItem.SetID,videodb://movies/sets/,/]</value>
    </variable>

    <variable name="Path_HolidayMode">
        <value condition="Skin.HasSetting(HolidayMode.Australia)">summer</value>
        <value>winter</value>
    </variable>

    <variable name="Path_SkinVariables_SkinFolder">
        <value condition="!String.IsEmpty(Skin.String(SkinVariables.SkinUser))">skin.arctic.fuse.3$INFO[Skin.String(SkinVariables.SkinUser),-,]</value>
        <value>skin.arctic.fuse.3</value>
    </variable>

    <variable name="Path_Shortcut_UseRawPath">
        <value condition="String.IsEqual(Window(Home).Property(Shortcuts.EditMenu),menu=searchwidgets)">&amp;&amp;grouping::grouping://shortcuts/search/&amp;&amp;use_rawpath::True</value>
        <value condition="$EXP[DialogShortcuts_IsWidgetMode_Expression]">&amp;&amp;use_rawpath::True</value>
    </variable>

    <variable name="Path_Shortcut_EditMenu">
        <value condition="!String.IsEmpty(Window(Home).Property(Shortcuts.EditMenu))">$INFO[Window(Home).Property(Shortcuts.EditMenu)]</value>
        <value>menu=sidemenu</value>
    </variable>

    <variable name="Path_SearchTerm_DoubleEncoded">
        <value condition="!String.IsEmpty(Container(320).ListItem.Label) + !String.IsEmpty(Container(310).ListItem.Label) + !Container(320).IsUpdating + !Container(310).IsUpdating">$INFO[Container(320).ListItem.Label]</value>
    </variable>

    <variable name="Path_SearchTerm_SingleEncoded">
        <value condition="!String.IsEmpty(Container(310).ListItem.Label) + !Container(310).IsUpdating">$INFO[Container(310).ListItem.Label]</value>
    </variable>

    <variable name="Path_SearchTerm">
        <value condition="!String.IsEmpty(Control.GetLabel(3000).index(1))">$INFO[Control.GetLabel(3000).index(1)]</value>
    </variable>

    <variable name="Path_VideoOSD_TMDbType">
        <value condition="VideoPlayer.Content(movies)">movie</value>
        <value condition="VideoPlayer.Content(episodes)">tv</value>
    </variable>

    <variable name="Path_Param_Query">
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),movie) | String.IsEqual(Window.Property(FenLight.DBType),tvshow)] + !String.IsEmpty(Window.Property(FenLight.TMDb_ID))">&amp;tmdb_id=$INFO[Window.Property(FenLight.TMDb_ID)]</value>
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)] + !String.IsEmpty(ListItem.UniqueID(tvshow.tmdb))">&amp;tmdb_id=$INFO[ListItem.UniqueID(tvshow.tmdb)]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),movie) + !String.IsEmpty(ListItem.Property(imdb_id))">&amp;imdb_id=$INFO[ListItem.Property(imdb_id)]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),movie) + !String.IsEmpty(ListItem.IMDBNumber) + String.StartsWith(ListItem.IMDBNumber,tt)">&amp;imdb_id=$INFO[ListItem.IMDBNumber]</value>
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)] + !String.IsEmpty(ListItem.TvShowTitle)">&amp;query=$INFO[ListItem.TvShowTitle]$INFO[ListItem.Year,&amp;episode_year=,]</value>
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),movie) | String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)] + !String.IsEmpty(ListItem.Title)">&amp;query=$INFO[ListItem.Title]$INFO[ListItem.Year,&amp;year=,]</value>
        <value condition="[String.IsEqual(Window.Property(FenLight.DBType),movie) | String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)]">$INFO[ListItem.Label,&amp;query=,]</value>
    </variable>

    <variable name="Path_Param_Type">
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),movie)">type=movie</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),tvshow) | String.IsEqual(Window.Property(FenLight.DBType),season) | String.IsEqual(Window.Property(FenLight.DBType),episode)">type=tv</value>
        <value condition="$EXP[Exp_IsPersonInfo]">type=person</value>
    </variable>

    <variable name="Path_Param_Number">
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),episode) + !String.IsEmpty(ListItem.Season) + !String.IsEmpty(ListItem.Episode)">&amp;season=$INFO[ListItem.Season]&amp;episode=$INFO[ListItem.Episode]</value>
        <value condition="String.IsEqual(Window.Property(FenLight.DBType),season) + !String.IsEmpty(ListItem.Season)">&amp;season=$INFO[ListItem.Season]</value>
    </variable>

    <variable name="Path_OSD_Episodes">
        <value condition="!Integer.IsEqual(VideoPlayer.PlaylistLength,1) + !Integer.IsEqual(VideoPlayer.PlaylistLength,0) + Integer.IsLess(VideoPlayer.PlaylistPosition,VideoPlayer.PlaylistLength)">playlistvideo://?reload=$INFO[VideoPlayer.Season,,_]$INFO[VideoPlayer.Episode,,_]$INFO[VideoPlayer.PlaylistPosition,,_]</value>
        <value condition="VideoPlayer.Content(episodes) + !String.IsEmpty(VideoPlayer.TvShowDBID) + !String.IsEmpty(VideoPlayer.Season)">videodb://tvshows/titles/$INFO[VideoPlayer.TvShowDBID]/$INFO[VideoPlayer.Season]/?tvshowid=$INFO[VideoPlayer.TvShowDBID]</value>
        <!-- I valori TMDbHelper sono stati rimossi: il container li risolveva come plugin:// di un
             addon non installato e Kodi apriva il prompt "installa addon" al solo focus del bottone
             OSD. Null.xsp lascia il container vuoto, che e' gia' il risultato di oggi. -->
        <value>special://skin/extras/playlists/Null.xsp</value>
    </variable>

    <variable name="Path_OSD_Cast">
        <!-- I valori TMDbHelper sono stati rimossi: il container li risolveva come plugin:// di un
             addon non installato e Kodi apriva il prompt "installa addon" al solo focus del bottone
             OSD. Null.xsp lascia il container vuoto, che e' gia' il risultato di oggi. -->
        <value>special://skin/extras/playlists/Null.xsp</value>
    </variable>

    <variable name="Path_OSD_NextRecommendation">
        <value condition="Integer.IsLess(VideoPlayer.PlaylistPosition,VideoPlayer.PlaylistLength)">playlistvideo://?reload=$INFO[VideoPlayer.Season,,_]$INFO[VideoPlayer.Episode,,_]$INFO[VideoPlayer.PlaylistPosition,,_]</value>
        <!-- I valori TMDbHelper sono stati rimossi: il container li risolveva come plugin:// di un
             addon non installato e Kodi apriva il prompt "installa addon" al solo focus del bottone
             OSD. Null.xsp lascia il container vuoto, che e' gia' il risultato di oggi. -->
        <value>special://skin/extras/playlists/Null.xsp</value>
    </variable>

    <variable name="Path_VideoInfo_OnlineSeasons">
