                        <param name="left">-10</param>
                    </include>
                    <left>-20</left>
                    <orientation>horizontal</orientation>
                    <height>1080</height>
                    <include content="Home_Submenu_Panel">
                        <param name="window">home</param>
                        <param name="id">00</param>
                    </include>
                    <include content="Home_Submenu_Panel" condition="!String.IsEmpty(Skin.String(HomeSwitcher.1101.Toggle))">
                        <param name="window">1101</param>
                        <param name="id">01</param>
                    </include>
                    <include content="Home_Submenu_Panel" condition="!String.IsEmpty(Skin.String(HomeSwitcher.1102.Toggle))">
                        <param name="window">1102</param>
                        <param name="id">02</param>
                    </include>
                    <include content="Home_Submenu_Panel" condition="!String.IsEmpty(Skin.String(HomeSwitcher.1103.Toggle))">
                        <param name="window">1103</param>
                        <param name="id">03</param>
                    </include>
                    <include content="Home_Submenu_Panel" condition="!String.IsEmpty(Skin.String(HomeSwitcher.1104.Toggle))">
                        <param name="window">1104</param>
                        <param name="id">04</param>
                    </include>
                </control>
            </control>
        </definition>
