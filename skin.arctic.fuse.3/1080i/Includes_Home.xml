    <!-- Disegno delle icone di destra (i pulsanti sono in Home_Header_Icon_Buttons, nella finestra dell'hub).
         Lo spegnimento occupa il posto dove prima c'era l'ingranaggio: stessa geometria del gruppo di prima,
         compreso il gruppo finale a larghezza zero che lascia l'ultimo spazio a destra. Il passo fra le icone
         (80 + 20) e' quello degli hub a sinistra. Il grouplist non conta le icone nascoste. -->
    <include name="Home_Header_Icons">
        <control type="grouplist">
            <include content="Object_Right" condition="Skin.HasSetting(HomeSwitcher.DisableSearch)">
                <param name="right">-40</param>
            </include>
            <right>-30</right>
            <align>right</align>
            <height>80</height>
            <width>600</width>
            <centertop>50%</centertop>
            <orientation>horizontal</orientation>
            <itemgap>20</itemgap>
            <include content="Home_Header_Icon">
                <param name="id">3180</param>
                <param name="visible">$EXP[Exp_Header_Profile_Enabled]</param>
                <param name="icon">$VAR[Image_ProfileThumb]</param>
                <param name="mono">false</param>
            </include>
            <include content="Home_Header_Icon">
                <param name="id">3181</param>
                <param name="visible">$EXP[Exp_Header_Slot1_Enabled]</param>
                <param name="icon">$VAR[Home_Header_Slot1_Icon]</param>
                <param name="mono">$EXP[Exp_Header_Slot1_MonoIcon]</param>
            </include>
            <include content="Home_Header_Icon">
                <param name="id">3182</param>
                <param name="visible">$EXP[Exp_Header_Slot2_Enabled]</param>
                <param name="icon">$VAR[Home_Header_Slot2_Icon]</param>
                <param name="mono">$EXP[Exp_Header_Slot2_MonoIcon]</param>
            </include>
            <include content="Home_Header_Icon">
                <param name="id">3183</param>
                <param name="icon">resource://resource.images.arcticfuse/icons/settings.png</param>
            </include>
            <include content="Home_Header_Icon">
                <param name="id">3184</param>
                <param name="icon">resource://resource.images.arcticfuse/icons/power.png</param>
            </include>
            <control type="group">
                <width>0</width>
            </control>
        </control>
    </include>

    <!-- Un'icona di destra. mono=true: sagoma della skin colorata come le icone degli hub (grigia
         trasparente, nera sul pallino bianco col fuoco). mono=false: immagine a colori (avatar, icone degli
         addon), ritagliata a cerchio e piu' piccola del pallino (56 su 80), cosi' col fuoco il pallino le fa da bordo;
         senza fuoco ha la stessa trasparenza delle icone degli hub. -->
    <include name="Home_Header_Icon">
        <param name="visible">true</param>
        <param name="mono">true</param>
        <definition>
            <control type="group">
                <width>80</width>
                <height>80</height>
                <visible>$PARAM[visible]</visible>
                <control type="image">
                    <visible>Integer.IsEqual(System.CurrentControlID,$PARAM[id])</visible>
                    <include>Texture_Menu_Highlight_H</include>
                </control>
                <control type="group">
                    <visible>$PARAM[mono]</visible>
                    <control type="image">
                        <visible>!Integer.IsEqual(System.CurrentControlID,$PARAM[id])</visible>
                        <include>Home_Grouplist_Icon_Definition</include>
                        <texture background="true" colordiffuse="main_fg_30">$PARAM[icon]</texture>
                    </control>
                    <control type="image">
                        <visible>Integer.IsEqual(System.CurrentControlID,$PARAM[id])</visible>
                        <include>Home_Grouplist_Icon_Definition</include>
                        <texture background="true" colordiffuse="$VAR[ColorSelected]">$PARAM[icon]</texture>
                    </control>
                </control>
                <control type="group">
                    <visible>![$PARAM[mono]]</visible>
                    <control type="image">
                        <visible>!Integer.IsEqual(System.CurrentControlID,$PARAM[id])</visible>
                        <include>Home_Header_Icon_Color_Definition</include>
                        <texture background="true" colordiffuse="main_fg_30" diffuse="diffuse/circle/circle_120.png">$PARAM[icon]</texture>
                    </control>
                    <control type="image">
                        <visible>Integer.IsEqual(System.CurrentControlID,$PARAM[id])</visible>
                        <include>Home_Header_Icon_Color_Definition</include>
                        <texture background="true" diffuse="diffuse/circle/circle_120.png">$PARAM[icon]</texture>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <!-- Niente aspectratio: con "scale" Kodi ritaglia l'immagine ma applica la maschera circolare all'immagine
         intera, e con un'immagine non quadrata (l'avatar e' 853x480) il cerchio esce tagliato sopra e sotto.
         Come il vecchio riquadro del profilo, l'immagine si adatta al quadrato e il cerchio resta intero. -->
    <include name="Home_Header_Icon_Color_Definition">
        <centerleft>50%</centerleft>
        <centertop>50%</centertop>
        <width>56</width>
        <height>56</height>
    </include>

    <variable name="Home_Header_Slot1_Icon">
        <value condition="!String.IsEmpty(Skin.String(HeaderIcons.Slot1.Icon))">$INFO[Skin.String(HeaderIcons.Slot1.Icon)]</value>
        <value>resource://resource.images.arcticfuse/icons/link.png</value>
    </variable>
    <variable name="Home_Header_Slot2_Icon">
        <value condition="!String.IsEmpty(Skin.String(HeaderIcons.Slot2.Icon))">$INFO[Skin.String(HeaderIcons.Slot2.Icon)]</value>
        <value>resource://resource.images.arcticfuse/icons/link.png</value>
    </variable>

    <!-- Nella ricerca (1105) il pulsante in alto a destra resta quello di sempre: l'icona della
         schermata principale. Le icone di destra degli hub non ci sono. -->
    <include name="Search_Header_Home_Button">
        <control type="grouplist">
            <include content="Object_Right" condition="Skin.HasSetting(HomeSwitcher.DisableSearch)">
                <param name="right">-40</param>
            </include>
            <right>-30</right>
            <align>right</align>
            <height>80</height>
            <width>400</width>
            <centertop>50%</centertop>
            <orientation>horizontal</orientation>
            <itemgap>20</itemgap>
            <control type="group">
                <width>80</width>
                <height>80</height>
                <include content="Home_Grouplist_Icon">
                    <param name="id">3171</param>
                    <param name="icon">$VAR[Home_Icon_home]</param>
                    <param name="window">home</param>
                </include>
            </control>
            <control type="group">
                <width>0</width>
            </control>
        </control>
    </include>

    <include name="Home_Submenu_Panel">
        <definition>
            <control type="group">

                <top>100</top>
                <width>560</width>
                <height>880</height>
                <control type="group">
                    <visible>Window.IsVisible($PARAM[window])</visible>
                    <include>Animation_SlideIn_Dialog</include>
                    <control type="group">
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsGreater(Container(80$PARAM[id]).NumItems,8)</visible>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,8)</visible>
                            <bottom>80</bottom>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,7)</visible>
                            <bottom>160</bottom>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,6)</visible>
                            <bottom>240</bottom>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,5)</visible>
                            <bottom>320</bottom>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,4)</visible>
                            <bottom>400</bottom>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,3)</visible>
                            <bottom>480</bottom>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,2)</visible>
                            <bottom>560</bottom>
                        </control>
                        <control type="group">
                            <include>Part_Background_Panel</include>
                            <visible>Integer.IsEqual(Container(80$PARAM[id]).NumItems,1)</visible>
                            <bottom>640</bottom>
                        </control>
                        <include content="Part_Scrollbar">
                            <param name="id">61$PARAM[id]</param>
                            <centerright>40</centerright>
                            <top>60</top>
                            <bottom>60</bottom>
                            <onleft>80$PARAM[id]</onleft>
                            <onright>PreviousMenu</onright>
                        </include>
                    </control>
                    <include content="List_DialogSelect">
                        <param name="id">80$PARAM[id]</param>
                        <param name="itemlayout_include">Layout_MenuList</param>
                        <top>100</top>
                        <bottom>60</bottom>
                        <left>60</left>
                        <right>60</right>
                        <oninfo>PreviousMenu</oninfo>
                        <onup>PreviousMenu</onup>
                        <ondown>noop</ondown>
                        <onleft>PreviousMenu</onleft>
                        <onright>61$PARAM[id]</onright>
                        <orientation>vertical</orientation>
                        <pagecontrol>61$PARAM[id]</pagecontrol>
                        <content>
                            <include>skinvariables-$PARAM[window]submenu-staticitems</include>
                        </content>
                    </include>

                </control>
            </control>
            <include content="Home_Focus_Object">
                <param name="window">$PARAM[window]</param>
            </include>
        </definition>
    </include>

    <include name="Home_Object">
        <param name="use_icons">Skin.HasSetting(HomeSwitcher.EnableIcons)</param>
        <definition>
            <control type="group">
                <top>100</top>
                <width>560</width>
                <height>80</height>
                <control type="group">
                    <left>80</left>
                    <control type="label">
                        <font>font_main_bold</font>
                        <textcolor>main_fg_30</textcolor>
                        <label>$INFO[Skin.String(HomeSwitcher.$PARAM[window].Name)]</label>
                        <left>30</left>
                        <visible>![$PARAM[use_icons]]</visible>
                    </control>
                    <control type="group">
                        <left>10</left>
                        <width>80</width>
                        <visible>$PARAM[use_icons]</visible>
                        <control type="image">
                            <include>Home_Grouplist_Icon_Definition</include>
                            <texture background="true" colordiffuse="main_fg_30">$VAR[Home_Icon_$PARAM[window]]</texture>
                        </control>
                    </control>
                </control>
            </control>
            <include content="Home_Focus_Object">
                <param name="window">$PARAM[window]</param>
            </include>
        </definition>
