    <include name="Home_Group_Definition">
        <left>view_pad</left>
        <right>view_pad</right>
        <centertop>170</centertop>
        <height>80</height>
    </include>

    <include name="Home_Grouplist_Definition">
        <left>-20</left>
        <height>160</height>
        <centertop>50%</centertop>
        <orientation>horizontal</orientation>
        <include content="Object_ItemGap" condition="Skin.HasSetting(HomeSwitcher.EnableIcons)">
            <param name="itemgap">20</param>
        </include>
        <itemgap>0</itemgap>
    </include>

    <include name="Home_Grouplist_Icon">
        <definition>
            <control type="group">
                <width>80</width>
                <height>80</height>
                <centertop>50%</centertop>
                <control type="button" id="$PARAM[id]">
                    <onclick>ReplaceWindow($PARAM[window])</onclick>
                    <texturenofocus />
                    <!-- Navigando a sinistra dalla home icon si torna sempre all'edit di ricerca,
                         mai alla X di clear (3005), anche se c'e' testo nel box. -->
                    <onleft>3001</onleft>
                </control>
                <control type="group">
                    <visible>![Window.IsVisible($PARAM[window]) + Integer.IsEqual(System.CurrentControlID,300)]</visible>
                    <control type="image">
                        <include>Home_Grouplist_Icon_Definition</include>
                        <texture background="true" colordiffuse="main_fg_30">$PARAM[icon]</texture>
                        <visible>!Control.HasFocus($PARAM[id])</visible>
                    </control>
                    <control type="image">
                        <include>Home_Grouplist_Icon_Definition</include>
                        <texture background="true" colordiffuse="$VAR[ColorSelected]">$PARAM[icon]</texture>
                        <visible>Control.HasFocus($PARAM[id])</visible>
                    </control>
                </control>
                <control type="group">
                    <visible>Window.IsVisible($PARAM[window]) + Integer.IsEqual(System.CurrentControlID,300)</visible>
                    <control type="image">
                        <include>Texture_Menu_Highlight_H</include>
                    </control>
                    <control type="image">
                        <include>Home_Grouplist_Icon_Definition</include>
                        <texture background="true" colordiffuse="$VAR[ColorSelected]">$PARAM[icon]</texture>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <include name="Home_Spacer">
        <param name="visible">true</param>
        <param name="use_icons">Skin.HasSetting(HomeSwitcher.EnableIcons)</param>
        <definition>
            <control type="button">
                <left>-560</left>
                <font>font_main_bold</font>
                <textcolor>00ffffff</textcolor>
                <focusedcolor>00ffffff</focusedcolor>
                <label>$PARAM[name]</label>
                <height>80</height>
                <include content="Object_Width" condition="$PARAM[use_icons]">
                    <param name="width">100</param>
                </include>
                <width>auto</width>
                <centertop>50%</centertop>
                <texturenofocus />
                <texturefocus />
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <include name="Home_Grouplist_Icon_Definition">
        <centerleft>50%</centerleft>
        <centertop>50%</centertop>
        <width>40</width>
        <height>40</height>
        <bordersize>icon_home_bordersize</bordersize>
    </include>
</includes>
