    <include name="Home_Focus_Object">
        <include content="Home_Focus_Faker">
            <param name="window">$PARAM[window]</param>
        </include>
        <include content="Home_Spacer">
            <param name="name">$INFO[Skin.String(HomeSwitcher.$PARAM[window].Name)]</param>
            <param name="icon">$VAR[Home_Icon_$PARAM[window]]</param>
        </include>
    </include>

    <include name="Home_Focus_Faker">
        <param name="use_icons">Skin.HasSetting(HomeSwitcher.EnableIcons)</param>
        <definition>
            <control type="group">
                <left>-480</left>
                <width>480</width>
                <top>100</top>
                <height>80</height>
                <control type="group">
                    <!-- Col fuoco sulle icone di destra la finestra resta quella dell'hub, ma la sua icona si spegne. -->
                    <visible>Window.IsVisible($PARAM[window]) + !$EXP[Exp_Header_Icons_HasFocus]</visible>
                    <control type="button">
                        <font>font_main_bold</font>
                        <textcolor>00ffffff</textcolor>
                        <focusedcolor>00ffffff</focusedcolor>
                        <label>$INFO[Skin.String(HomeSwitcher.$PARAM[window].Name)]</label>
                        <width>auto</width>
                        <include>Texture_Highlight_Button_FakeFocus_H</include>
                        <visible>![$PARAM[use_icons]]</visible>
                    </control>
                    <control type="label">
                        <font>font_main_bold</font>
                        <textcolor>$VAR[ColorSelected]</textcolor>
                        <label>$INFO[Skin.String(HomeSwitcher.$PARAM[window].Name)]</label>
                        <left>30</left>
                        <visible>![$PARAM[use_icons]]</visible>
                    </control>
                    <control type="group">
                        <left>10</left>
                        <width>80</width>
                        <visible>$PARAM[use_icons]</visible>
                        <control type="image">
                            <include>Texture_Menu_Highlight_H</include>
                        </control>
                        <control type="image">
                            <include>Home_Grouplist_Icon_Definition</include>
                            <texture background="true" colordiffuse="$VAR[ColorSelected]">$VAR[Home_Icon_$PARAM[window]]</texture>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <include name="Home_Submenu_Start">
        <control type="button" id="70$PARAM[id]">
            <texturefocus />
            <texturenofocus />
            <onfocus condition="!Integer.IsEqual(Container(80$PARAM[id]).NumItems,0)">SetFocus(80$PARAM[id],0,absolute)</onfocus>
            <onfocus condition="Integer.IsEqual(Container(80$PARAM[id]).NumItems,0)">PreviousMenu</onfocus>
            <onfocus condition="Integer.IsEqual(Container(80$PARAM[id]).NumItems,0)">SetProperty(Bumper.Direction,Up,Home)</onfocus>
            <onfocus condition="Integer.IsEqual(Container(80$PARAM[id]).NumItems,0)">ActivateWindow(1180)</onfocus>
        </control>
    </include>

    <include name="Home_Horz_Submenu">
        <definition>
            <include content="Home_Submenu_Start"><param name="id">00</param></include>
            <include content="Home_Submenu_Start"><param name="id">01</param></include>
            <include content="Home_Submenu_Start"><param name="id">02</param></include>
            <include content="Home_Submenu_Start"><param name="id">03</param></include>
            <include content="Home_Submenu_Start"><param name="id">04</param></include>
