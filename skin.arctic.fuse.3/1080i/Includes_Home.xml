    <!-- La lista e' la rotazione degli hub a partire dalla finestra corrente: [corrente, successivi...,
         icone di destra, precedenti...]. 300 legge ListItem(1) a destra e ListItem(-1) a sinistra (che
         avvolge). L'elemento "icone di destra" separa l'ultimo hub dal primo: a destra dell'ultimo hub il
         fuoco passa alle icone (vedi onright di 300), a sinistra del primo hub non succede niente. -->
    <include name="Home_ControlList">
        <control type="list" id="399">
            <top>-2000</top>
            <height>10</height>
            <orientation>horizontal</orientation>
            <itemlayout width="1" />
            <focusedlayout width="1" />
            <content>
                <include content="Home_ControlList_Items">
                    <param name="mod" />
                </include>

                <item>
                    <property name="action">noop</property>
                    <property name="header_icons">true</property>
                </item>

                <include content="Home_ControlList_Items">
                    <param name="mod">!</param>
                </include>
            </content>
        </control>
    </include>

    <include name="Home_Movement">
        <onup>SetProperty(Bumper.Direction,Up,Home)</onup>
        <onup>ActivateWindow(1181)</onup>
        <oninfo>ActivateWindow(1181)</oninfo>
        <ondown>$VAR[Hub_Action_Down]</ondown>

        <onback condition="Player.HasMedia">SetProperty(FullscreenRefocus,SetFocus(300))</onback>
        <onback condition="Player.HasMedia">309</onback>
        <!-- Indietro porta il fuoco all'icona di spegnimento con navigazione diretta, in un solo passo: passare
             da un pulsante nascosto faceva riaccendere per un istante l'icona dell'hub. Dove lo spegnimento non
             c'e' (ricerca, 1109) Kodi non trova il controllo e non succede niente. -->
        <onback condition="!Player.HasMedia">3184</onback>
    </include>

    <!-- 300 e le icone di destra stanno al PRIMO livello della definizione, non dentro un gruppo: Kodi
         cerca <nested /> solo li' o come figlio diretto (GUIIncludes.cpp, InsertNested). Dentro un gruppo il
         contenuto passato da chi include (per la ricerca: SetFocus(3001) sull'intestazione) viene buttato via
         in silenzio, e nella ricerca il fuoco restava su 300 con la barra nascosta.
         Chi deve sapere "il fuoco e' sull'intestazione" usa $EXP[Exp_Header_HasFocus]. -->
    <include name="Home_Control">
        <param name="onclick_condition">true</param>
        <param name="header_icons">false</param>
        <definition>
            <include>Home_ControlList</include>
            <control type="button" id="300">
                <top>-1000</top>
                <height>10</height>
                <texturenofocus />
                <texturefocus />

                <onleft>$INFO[Container(399).ListItem(-1).Property(action)]</onleft>
                <onright>$INFO[Container(399).ListItem(1).Property(action)]</onright>
                <!-- Navigazione numerica e non SetFocus: Kodi (CGUIWindow::OnMove) salta da solo le icone
                     nascoste seguendo la loro catena, SetFocus su un controllo nascosto invece fallisce. -->
                <onright condition="String.IsEqual(Container(399).ListItem(1).Property(header_icons),true)">3180</onright>

                <include content="Home_Header_Focus_Actions">
                    <param name="overlay">$PARAM[overlay]</param>
                </include>
                <!-- RETE, NON CORREZIONE, e va tolta il giorno in cui si capisce chi muove quel fuoco.
                     Nella finestra della ricerca il 300 si raggiunge in un modo solo voluto: il
                     dirottamento del 3001 quando RefocusMenu e' alzata (l'Indietro dalla tastiera a
                     schermo o dal pulsante filtri). Da 3000 e da 3005 non c'e' nessuna navigazione che
                     porti qui. Ogni altro arrivo e' un incidente, e costa caro, perche' un Select su
                     questo bottone fa ActivateWindow della scorciatoia, cioe' esce dalla ricerca: il
                     sintomo e' a un passo dal guasto, ed e' per questo che sembra intermittente.
                     Il difetto e' tornato tre volte (21/09: 00:51, 03:35, 05:54) sempre con la stessa
                     firma, fuoco 3005 -> 300 -> Home, e fra i due campioni del watcher non si registra
                     niente. Le tre diagnosi tentate sono cadute tutte; l'ultima ("il 3005 smette di
                     poter prendere il fuoco") e' smentita dal fatto che ora e' focalizzabile sempre e
                     il difetto resta. Finche' la causa non si trova, il danno si rende impossibile.
                     RefocusMenu la pulisce il 3001 DOPO aver dirottato, quindi quando questo onfocus
                     gira la richiesta e' ancora alzata e il rimbalzo non scatta.
                     tests/test_fuoco_intestazione.py -->
                <onfocus condition="Window.IsVisible(1105) + String.IsEmpty(Window.Property(RefocusMenu))">SetFocus(3000)</onfocus>

                <onclick condition="$PARAM[onclick_condition] + !String.IsEmpty(Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Target))">ActivateWindow($INFO[Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Target)],$INFO[Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Path)],return)</onclick>
                <onclick condition="$PARAM[onclick_condition] + String.IsEmpty(Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Target))">$INFO[Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Path)]</onclick>
                <onclick condition="Window.IsVisible(1105)">SetFocus(3001)</onclick>
                <onclick condition="Window.IsVisible(1105)">AlarmClock(reclick,Action(Select),00:00,silent)</onclick>

                <include>Home_Movement</include>

                <nested />
            </control>
            <include content="Home_Header_Icon_Buttons" condition="$PARAM[header_icons]">
                <param name="overlay">$PARAM[overlay]</param>
            </include>
            <control type="image">
                <include>Home_Fade_Animation</include>
                <visible>!String.IsEmpty(Window(Home).Property(HomeSwitcher.IsVisible))</visible>
                <texture colordiffuse="main_bg_70">resource://resource.images.arcticfuse/backgrounds/overlay/combined_topmenu.png</texture>
                <bottom>0</bottom>
            </control>
        </definition>
    </include>

    <!-- Stato dell'intestazione quando uno dei suoi controlli prende il fuoco: identico per 300 e per le icone. -->
    <include name="Home_Header_Focus_Actions">
        <onfocus>SetProperty(HomeSwitcher.IsVisible,True,Home)</onfocus>
        <onfocus condition="$PARAM[overlay]">SetProperty(InfoPanel.FullSwitch,Wall,Home)</onfocus>
        <onfocus condition="![$PARAM[overlay]]">ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
        <onfocus condition="$PARAM[overlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
        <onfocus condition="![$PARAM[overlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
    </include>

    <!-- ICONE DI DESTRA DELL'INTESTAZIONE: profilo (facoltativo), slot 1 e 2 (facoltativi), impostazioni,
         spegnimento. I pulsanti stanno nella finestra dell'hub (il fuoco non puo' entrare nel dialogo 1182
         che disegna l'intestazione) e sono invisibili fuori schermo come 300; il disegno e' in
         Home_Header_Icons, che li riconosce da System.CurrentControlID.
         La catena sinistra/destra e' completa anche attraverso le icone nascoste: Kodi la percorre saltando
         quelle che non possono avere il fuoco. Destra sullo spegnimento non fa niente. -->
    <include name="Home_Header_Icon_Button">
        <param name="onright" />
        <param name="onback">3184</param>
        <definition>
            <control type="button" id="$PARAM[id]">
                <top>-1000</top>
                <height>10</height>
                <texturenofocus />
                <texturefocus />
                <visible>$PARAM[visible]</visible>
                <onleft>$PARAM[onleft]</onleft>
                <onright>$PARAM[onright]</onright>
                <ondown>$VAR[Hub_Action_Down]</ondown>
                <include content="Home_Header_Focus_Actions">
                    <param name="overlay">$PARAM[overlay]</param>
                </include>
                <onback condition="Player.HasMedia">SetProperty(FullscreenRefocus,SetFocus($PARAM[id]))</onback>
                <onback condition="Player.HasMedia">309</onback>
                <onback condition="!Player.HasMedia">$PARAM[onback]</onback>
                <nested />
            </control>
        </definition>
    </include>

