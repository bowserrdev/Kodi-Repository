    <include name="Action_Widget_OnBack">
        <param name="enable">True</param>
        <param name="ondisabled">noop</param>
        <definition>

            <!-- Widgets are now infinite-scroll, so back navigation is deterministic (independent of the
                 Navigation.OnBack skin toggle): from any item past the first, back returns to the first item
                 of the widget; only on the first item does back leave the widget (to the hub icon / search box
                 via refocus). Lets the user climb back to the top of a long widget without spamming back. -->

            <!-- Not on first item: return to the first item of the widget. -->
            <onback condition="$PARAM[enable] + !Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">$PARAM[grouplistid]</onback>
            <onback condition="$PARAM[enable] + !Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">SetFocus($PARAM[id],0,absolute)</onback>

            <!-- On first item: leave the widget (parent / hub icon / search box, via refocus). -->
            <onback condition="$PARAM[enable] + Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">$PARAM[grouplistid]</onback>
            <onback condition="$PARAM[enable] + Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">AlarmClock(refocus2,$PARAM[refocus],00:00,silent)</onback>

        </definition>
    </include>

