<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload condition="Skin.HasSetting(SkinUserLogin.StartupLoginScreen) + !Skin.HasSetting(SkinUserLogin.Disabled) + String.IsEmpty(Window(Home).Property(StartupReplaceWindow))">SetProperty(StartupReplaceWindow,1195,Home)</onload>

    <include>Action_ButtonMenu_Onload</include>

    <!-- Lotto 153. Prima: questa finestra apriva lo splash e lanciava skinvariables-startup.json,
         e la Home compariva 40 ms dopo la FINE di quello script, cioe' 2,45 s dopo (misurato sulla
         stick, avvio delle 15:05:52.776 -> 15:05:55.223 -> Home a 55.263). Tutto cio' che lo script
         fa dopo il primo avvio in assoluto e' inerte: 20 Skin.SetString(SkinConstant.Numeric.*) che
         nessuno legge, 19 default gia' scritti nelle impostazioni, un ReloadDone che rilegge solo
         se stesso, uno sleep di 0,5 s e un blocco PVR le cui regole non passano.
         Ora lo script parte solo quando i default non ci sono ancora; a regime la finestra passa
         direttamente alla Home, replicando riga per riga le stesse regole del json. -->
    <onload condition="!Skin.HasSetting(DefaultConfig.InitDone)">RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/skinvariables-startup.json,use_rules=True,var_image_simplebackground=$VAR[Image_SimpleBackground])</onload>

    <onload condition="Skin.HasSetting(DefaultConfig.InitDone) + !String.IsEmpty(Window(Home).Property(StartupReplaceWindow))">ReplaceWindow($INFO[Window(Home).Property(StartupReplaceWindow)])</onload>
    <onload condition="Skin.HasSetting(DefaultConfig.InitDone) + String.IsEmpty(Window(Home).Property(StartupReplaceWindow))">ReplaceWindow($INFO[System.StartupWindow])</onload>
    <onload condition="Skin.HasSetting(DefaultConfig.InitDone) + !String.IsEmpty(Skin.String(Startup.VideoPath))">PlayMedia("$INFO[Skin.String(Startup.VideoPath)]")</onload>

    <onunload>ClearProperty(StartupReplaceWindow,Home)</onunload>
</window>