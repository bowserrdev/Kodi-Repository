<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1143">
    <defaultcontrol always="true">6003</defaultcontrol>

    <controls>

        <control type="group">
            <include>OSD_HideControls</include>
            <!-- LOTTO 186 :: qui stava il riquadro "prossimo elemento" (lista 450 +
                 gruppo con locandina e due etichette). Rimosso: costava 479-689 ms di
                 thread GUI alla prima apertura dell'OSD di ogni sessione, misurati come
                 silenzio fra "Loading skin file: Custom_1143" e l'evento successivo, con
                 tanto di "OutputPicture - timeout waiting for buffer" sul video.
                 Il costo era la registrazione di ~1300 infobool: l'immagine era una
                 variabile da 51 valori (uno per posizione di playlist) e ognuno rimandava
                 a una $VAR generata da 10 valori con condizioni fino a 7 termini; piu'
                 due etichette da 51 valori.
                 E non si vedeva mai: Path_OSD_NextRecommendation dava playlistvideo://
                 solo con PlaylistPosition < PlaylistLength, e Fen Light non costruisce mai
                 una playlist di Kodi (make_playlist() in kodi_utils.py non ha chiamanti).
                 Restava Null.xsp, container vuoto, gruppo nascosto.
                 Il bottone 6003 (salta avanti) e la fila di bottoni restano. -->

            <control type="group">
                <left>view_pad</left>
                <right>view_pad</right>

                <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>
                <visible>!Window.IsVisible(DialogSlider.xml)</visible>

                <include content="OSD_CustomDialog_GroupList">
                    <param name="dialog_id">1143</param>
                    <param name="onclick">$VAR[Action_OSD_SkipNext]</param>
                    <param name="icon">$VAR[Image_OSD_SkipNext]</param>
                    <param name="button_3">true</param>

                    <!-- LOTTO 189 :: era Close, che chiude "il dialogo in cima" e non il proprio.
                         Stessa trappola del lotto 185 sui bottoni finti: oggi non morde, ma con
                         due tasti nello stesso frame chiuderebbe la VideoOSD invece di 1143.
                         Id letterale e non $PARAM[dialog_id]: qui siamo al punto di CHIAMATA
                         dell'include, fuori da ogni <definition>, dove $PARAM non si risolve. -->
                    <param name="onup">Dialog.Close(1143)</param>
                    <param name="onup_02">SetFocus(8200)</param>

                </include>
            </control>
        </control>

    </controls>
</window>
