    <!-- Horizontal Layout (Classic) -->
    <include name="View_Combined_Row_Horz">
        <definition>
            <control type="group">
                <visible>Control.IsVisible(52$PARAM[id])</visible>
                <control type="group">

                    <!-- LOTTO 418: il rilevatore della riga episodi in attesa, prima della riga -->
                    <include content="Riga_Attesa">
                        <param name="id">53$PARAM[id]</param>
                        <!-- lo schermo decide: la riga mostra un'altra stagione, quindi e' gia' in attesa -->
                        <param name="identita">!$EXP[Exp_Episodi_53$PARAM[id]_AltraLista]</param>
                    </include>
                    <include content="$PARAM[include]">
                        <param name="id">53$PARAM[id]</param>
                        <top>view_row</top>
                        <pagecontrol>60</pagecontrol>

                        <include content="Action_View_Movement_OnBack">
                            <param name="id">53$PARAM[id]</param>
                            <param name="onback">[Integer.IsEqual(Container(53$PARAM[id]).CurrentItem,1)]</param>
                            <param name="always">True</param>
                            <param name="backid">63</param>
                            <param name="menuid">63</param>
                        </include>

                        <include content="Object_HitRect">
                            <param name="x">view_pad</param>
                            <param name="y">586</param>
                            <param name="w">1640</param>
                            <param name="h">view_poster_item_h</param>
                        </include>

                        <!-- LOTTO 418: qui Arctic Fuse azzerava la riga uscendo verso le stagioni
                             (SetFocus(53x,0,absolute) prima di questo onup). Era legato al fuoco invece che alla
                             lista: azzerava salendo alla stessa stagione, e non azzerava quando il fuoco arrivava
                             alle stagioni per un'altra strada (ritorno dal player, Window Init). Adesso la riga
                             che cambia stagione passa dall'attesa, decisa dalla skin guardando lo schermo
                             (View_53n_Content), e salire non sposta niente. RIPOSIZIONAMENTO.md. -->
                        <onup>52$PARAM[id]</onup>

                        <include content="Action_View_Movement_OnDown">
                            <param name="id">$PARAM[id]</param>
                        </include>

                        <!-- LOTTO 418: mentre la riga e' in attesa (stagione o serie appena cambiata, la skin ha
                             chiesto il segnaposto) gli elementi non si vedono, compreso il segnaposto stesso: si vedono
                             solo i segnaposto semitrasparenti qui sotto. Una ricostruzione della STESSA stagione
                             (segna come visto) non e' attesa, e la riga resta a schermo com'e'. Prima c'era una
                             dissolvenza su IsUpdating + NumItems=0 che non poteva distinguere i due casi.
                             Dissolvenza e non visible: un contenitore nascosto non rilegge il path, e la ricarica
                             che lo riempie non arriverebbe. Vedi Riga_Attesa in Includes_Widgets.xml. -->
                        <animation effect="fade" start="100" end="0" time="0" condition="Control.IsVisible(97453$PARAM[id]) | $EXP[Exp_Episodi_53$PARAM[id]_AltraLista]">Conditional</animation>

                        <visible>Container(52$PARAM[id]).ListItem.IsFolder</visible>
                        <onclick condition="Container(53$PARAM[id]).ListItem.IsFolder">Container.Update($INFO[Container(53$PARAM[id]).ListItem.FolderPath])</onclick>
                        <onclick condition="Container(53$PARAM[id]).ListItem.IsFolder">SetFocus(50)</onclick>
                        <onclick condition="!Container(53$PARAM[id]).ListItem.IsFolder">PlayMedia($ESCINFO[Container(53$PARAM[id]).ListItem.FileNameAndPath])</onclick>
                        <content target="$VAR[Path_CollectionNode_Target]" sortby="$VAR[View_Combined_SortBy]" sortorder="ascending">$VAR[View_53$PARAM[id]_Content]</content>
                        <onfocus>SetProperty(TMDbHelper.WidgetContainer,53$PARAM[id],$PARAM[finestra])</onfocus>
                        <onfocus>ClearProperty(Background.ShowOverlay,Home)</onfocus>
                        <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
                        <!-- LOTTO 418: il fuoco e' sugli episodi. Lo legge MyVideoNav uscendo verso il player
                             (Episodi.Rientro), e lo cancella il selettore delle stagioni quando il fuoco risale. -->
                        <onfocus>SetProperty(Episodi.Fuoco,53$PARAM[id])</onfocus>

                    </include>

                    <include content="Widget_Busy">
                        <param name="label">$INFO[Container(52$PARAM[id]).ListItem.Label]</param>
                        <param name="visible">Control.IsVisible(97453$PARAM[id]) | $EXP[Exp_Episodi_53$PARAM[id]_AltraLista]</param>
                        <param name="include">$PARAM[include]</param>
                        <top>view_row</top>
                        <left>view_pad</left>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="View_Combined_List_Horz_Selector_Movement">
