    <!-- LOTTO 418: IL PATH DELLA RIGA EPISODI, quando la stagione e' una cartella di Fen Light nella finestra
         Video. Porta la posizione (pgctl), la richiesta del segnaposto (vuota) e il gettone con cui il servizio
         ordina la ricostruzione (pages/reload): sono i tre pezzi che servono a router._svuota_prima per
         distruggere la riga quando cambia stagione o serie. Stanno DENTRO il valore della variabile, che
         esiste solo quando c'e' il path (lotto 155: accodati fuori resterebbero da soli). Solo Fen Light,
         perche' accodati a un percorso della libreria o di un altro addon lo romperebbero; solo la finestra
         Video, perche' la vista e' inclusa anche in MyPrograms e una posizione con la finestra sbagliata non
         la ricaricherebbe nessuno. Gli altri valori restano quelli di Arctic Fuse. -->
    <variable name="View_530_Content">
        <value condition="Window.IsActive(10025) + String.IsEmpty(Window.Property(SpecialFolderPath)) + Container(520).ListItem.IsFolder + String.StartsWith(Container(520).ListItem.FolderPath,plugin://plugin.video.fenlight/)">$INFO[Container(520).ListItem.FolderPath]&amp;pgctl=10025.530&amp;vuota=segnaposto$INFO[Window(Home).Property(fenlight.pg.w10025.ctl530.pages),&amp;pages=,]</value>
        <value condition="String.IsEmpty(Window.Property(SpecialFolderPath)) + !String.IsEmpty(Container(520).ListItem.FolderPath) + Container(520).ListItem.IsFolder">$INFO[Container(520).ListItem.FolderPath]</value>
        <value condition="!String.IsEmpty(Window.Property(SpecialFolderPath))">$INFO[Window.Property(SpecialFolderPath)]</value>
    </variable>
    <variable name="View_531_Content">
        <value condition="Window.IsActive(10025) + String.IsEmpty(Window.Property(SpecialFolderPath)) + Container(521).ListItem.IsFolder + String.StartsWith(Container(521).ListItem.FolderPath,plugin://plugin.video.fenlight/)">$INFO[Container(521).ListItem.FolderPath]&amp;pgctl=10025.531&amp;vuota=segnaposto$INFO[Window(Home).Property(fenlight.pg.w10025.ctl531.pages),&amp;pages=,]</value>
        <value condition="String.IsEmpty(Window.Property(SpecialFolderPath)) + !String.IsEmpty(Container(521).ListItem.FolderPath) + Container(521).ListItem.IsFolder">$INFO[Container(521).ListItem.FolderPath]</value>
        <value condition="!String.IsEmpty(Window.Property(SpecialFolderPath))">$INFO[Window.Property(SpecialFolderPath)]</value>
    </variable>
    <variable name="View_532_Content">
        <value condition="Window.IsActive(10025) + String.IsEmpty(Window.Property(SpecialFolderPath)) + Container(522).ListItem.IsFolder + String.StartsWith(Container(522).ListItem.FolderPath,plugin://plugin.video.fenlight/)">$INFO[Container(522).ListItem.FolderPath]&amp;pgctl=10025.532&amp;vuota=segnaposto$INFO[Window(Home).Property(fenlight.pg.w10025.ctl532.pages),&amp;pages=,]</value>
        <value condition="String.IsEmpty(Window.Property(SpecialFolderPath)) + !String.IsEmpty(Container(522).ListItem.FolderPath) + Container(522).ListItem.IsFolder">$INFO[Container(522).ListItem.FolderPath]</value>
        <value condition="!String.IsEmpty(Window.Property(SpecialFolderPath))">$INFO[Window.Property(SpecialFolderPath)]</value>
    </variable>
    <variable name="View_533_Content">
        <value condition="Window.IsActive(10025) + String.IsEmpty(Window.Property(SpecialFolderPath)) + Container(523).ListItem.IsFolder + String.StartsWith(Container(523).ListItem.FolderPath,plugin://plugin.video.fenlight/)">$INFO[Container(523).ListItem.FolderPath]&amp;pgctl=10025.533&amp;vuota=segnaposto$INFO[Window(Home).Property(fenlight.pg.w10025.ctl533.pages),&amp;pages=,]</value>
        <value condition="String.IsEmpty(Window.Property(SpecialFolderPath)) + !String.IsEmpty(Container(523).ListItem.FolderPath) + Container(523).ListItem.IsFolder">$INFO[Container(523).ListItem.FolderPath]</value>
        <value condition="!String.IsEmpty(Window.Property(SpecialFolderPath))">$INFO[Window.Property(SpecialFolderPath)]</value>
    </variable>
    <variable name="View_534_Content">
        <value condition="Window.IsActive(10025) + String.IsEmpty(Window.Property(SpecialFolderPath)) + Container(524).ListItem.IsFolder + String.StartsWith(Container(524).ListItem.FolderPath,plugin://plugin.video.fenlight/)">$INFO[Container(524).ListItem.FolderPath]&amp;pgctl=10025.534&amp;vuota=segnaposto$INFO[Window(Home).Property(fenlight.pg.w10025.ctl534.pages),&amp;pages=,]</value>
        <value condition="String.IsEmpty(Window.Property(SpecialFolderPath)) + !String.IsEmpty(Container(524).ListItem.FolderPath) + Container(524).ListItem.IsFolder">$INFO[Container(524).ListItem.FolderPath]</value>
        <value condition="!String.IsEmpty(Window.Property(SpecialFolderPath))">$INFO[Window.Property(SpecialFolderPath)]</value>
    </variable>
    <variable name="View_536_Content">
        <value condition="String.IsEmpty(Window.Property(SpecialFolderPath)) + !String.IsEmpty(Container(526).ListItem.FolderPath) + Container(526).ListItem.IsFolder">$INFO[Container(526).ListItem.FolderPath]</value>
