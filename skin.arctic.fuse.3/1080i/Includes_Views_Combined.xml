    <!-- LOTTO 427: GLI EPISODI VISTI DELLA STAGIONE COL FUOCO, dal pannello episodi. La lista stagioni non si ricarica
         piu' a ogni "segna come visto" (kodi_utils.PANNELLI_EPISODI): ricaricarla passava dal dialogo di attesa, che
         l'indietro annulla, e Kodi ripiegava sulla radice della libreria. Il numero che cambia lo porta il pannello,
         che si ricarica comunque e senza dialogo, sul suo primo elemento (fenlight.stagione.visti), e vale solo se il
         pannello mostra proprio la stagione col fuoco (il timbro fenlight.lista, come in Exp_Episodi_53n_AltraLista).
         Lo stesso trucco della voce "Aggiungi/Rimuovi dalla mia lista": l'etichetta non porta il valore, lo chiede.
         Altrimenti resta quello della voce della stagione. Lo legge Label_Episodi_Visti (Includes_Info.xml). -->
    <expression name="Exp_Stagione_Visti_Dal_Pannello">[Control.IsVisible(530) + String.IsEqual(Container(530).ListItemAbsolute(0).Property(fenlight.lista),Container(520).ListItem.FolderPath)] | [Control.IsVisible(531) + String.IsEqual(Container(531).ListItemAbsolute(0).Property(fenlight.lista),Container(521).ListItem.FolderPath)] | [Control.IsVisible(532) + String.IsEqual(Container(532).ListItemAbsolute(0).Property(fenlight.lista),Container(522).ListItem.FolderPath)] | [Control.IsVisible(533) + String.IsEqual(Container(533).ListItemAbsolute(0).Property(fenlight.lista),Container(523).ListItem.FolderPath)] | [Control.IsVisible(534) + String.IsEqual(Container(534).ListItemAbsolute(0).Property(fenlight.lista),Container(524).ListItem.FolderPath)]</expression>
    <variable name="Label_Stagione_Visti_Dal_Pannello">
        <value condition="Control.IsVisible(530) + String.IsEqual(Container(530).ListItemAbsolute(0).Property(fenlight.lista),Container(520).ListItem.FolderPath)">$INFO[Container(530).ListItemAbsolute(0).Property(fenlight.stagione.visti)]</value>
        <value condition="Control.IsVisible(531) + String.IsEqual(Container(531).ListItemAbsolute(0).Property(fenlight.lista),Container(521).ListItem.FolderPath)">$INFO[Container(531).ListItemAbsolute(0).Property(fenlight.stagione.visti)]</value>
        <value condition="Control.IsVisible(532) + String.IsEqual(Container(532).ListItemAbsolute(0).Property(fenlight.lista),Container(522).ListItem.FolderPath)">$INFO[Container(532).ListItemAbsolute(0).Property(fenlight.stagione.visti)]</value>
        <value condition="Control.IsVisible(533) + String.IsEqual(Container(533).ListItemAbsolute(0).Property(fenlight.lista),Container(523).ListItem.FolderPath)">$INFO[Container(533).ListItemAbsolute(0).Property(fenlight.stagione.visti)]</value>
        <value condition="Control.IsVisible(534) + String.IsEqual(Container(534).ListItemAbsolute(0).Property(fenlight.lista),Container(524).ListItem.FolderPath)">$INFO[Container(534).ListItemAbsolute(0).Property(fenlight.stagione.visti)]</value>
    </variable>

