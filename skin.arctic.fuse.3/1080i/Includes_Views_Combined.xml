        <value condition="$EXP[Exp_Episodi_531_FenLight]">$INFO[Container(521).ListItem.FolderPath]&amp;pgctl=10025.531&amp;vuota=segnaposto&amp;attesa=0$INFO[Window(Home).Property(fenlight.panel_reload),&amp;pannello=,]$INFO[Window(Home).Property(fenlight.pg.w10025.ctl531.pages),&amp;pages=,]</value>
        <value condition="String.IsEmpty(Window.Property(SpecialFolderPath)) + !String.IsEmpty(Container(521).ListItem.FolderPath) + Container(521).ListItem.IsFolder">$INFO[Container(521).ListItem.FolderPath]</value>
        <value condition="!String.IsEmpty(Window.Property(SpecialFolderPath))">$INFO[Window.Property(SpecialFolderPath)]</value>
    </variable>
    <expression name="Exp_Episodi_532_FenLight">Window.IsActive(10025) + String.IsEmpty(Window.Property(SpecialFolderPath)) + Container(522).ListItem.IsFolder + String.StartsWith(Container(522).ListItem.FolderPath,plugin://plugin.video.fenlight/)</expression>
