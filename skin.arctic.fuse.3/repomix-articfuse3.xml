<contents>
    <rules name="parts_onclick">
        <rule>
            <condition>{item_target}!=</condition>
            <value>
                <![CDATA[
                <onclick>ActivateWindow({item_target},{item_path},return)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==RebootToAndroid</condition>
            <value>
                <![CDATA[
                <onclick>System.ExecWait("/usr/sbin/rebootfromnand")</onclick>
                <onclick>Reboot()</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>{item_path}==Custom_Submenu</condition>
            <value>
                <![CDATA[
                <onclick condition="!String.IsEqual(Window(Home).Property(SubGroup.IsVisible),{item_guid})">SetProperty(SubGroup.IsVisible,{item_guid},Home)</onclick>
                <onclick condition="String.IsEqual(Window(Home).Property(SubGroup.IsVisible),{item_guid})">ClearProperty(SubGroup.IsVisible,Home)</onclick>
                ]]>
            </value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>
                <![CDATA[
                <onclick>{item_path}</onclick>
                ]]>
            </value>
        </rule>
    </rules>
</contents>
</file>

<file path="shortcuts/generator/data/setup/powermenu_item.xml">
<contents>
    <rules name="parts_visible">
        <rule>
            <condition>{item_path}==ActivateWindow(1195)</condition>
            <value>!Skin.HasSetting(SkinUserLogin.Disabled)</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>True</value>
        </rule>
    </rules>
    <rules name="item_label">
        <rule>
            <condition>{item_label}==$LOCALIZE[12600]</condition>
            <value>$INFO[Weather.Temperature, &#226;&#8364;&#162; ,]</value>
        </rule>
        <rule>
            <condition>{item_label}==$LOCALIZE[8]</condition>
            <value>$INFO[Weather.Temperature, &#226;&#8364;&#162; ,]</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>{item_label}</value>
        </rule>
    </rules>
    <rules name="item_icon">
        <rule>
            <condition>{item_label}==$LOCALIZE[12600]</condition>
            <value>$INFO[Weather.FanartCode,resource://resource.images.weathericons.white/,.png]</value>
        </rule>
        <rule>
            <condition>{item_label}==$LOCALIZE[8]</condition>
            <value>$INFO[Weather.FanartCode,resource://resource.images.weathericons.white/,.png]</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>{item_icon}</value>
        </rule>
    </rules>
    <rules name="item_bordersize">
        <rule>
            <condition>{item_label}==$LOCALIZE[12600]</condition>
            <value>21</value>
        </rule>
        <rule>
            <condition>{item_label}==$LOCALIZE[8]</condition>
            <value>21</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>16</value>
        </rule>
    </rules>
    <rules name="item_closemenu_command">
        <rule>
            <condition>{item_path}!=Custom_Submenu</condition>
            <value>Close</value>
        </rule>
        <rule>
            <condition>True</condition>
            <value>noop</value>
        </rule>
    </rules>
</contents>
</file>

