<file path="1080i/Custom_1192_HolidayTheme.xml">
<?xml version="1.0" encoding="UTF-8"?>
<window id="1192" type="dialog">
    <zorder>9999</zorder>
    <visible>!Window.IsVisible(startup)</visible>
    <visible>Skin.HasSetting(EnableHolidayTheme)</visible>
    <controls>

        <!-- With thanks to SualFred -->
        <!-- Christmas theme snow loop textures originally from skin.embuary -->

        <control type="group">
            <visible>!System.ScreenSaverActive + !Window.IsVisible(slideshow)</visible>
            <!-- XMAS -->
            <control type="group">
                <visible>$EXP[Exp_Christmas_Theme]</visible>
                <control type="group">
                    <posx>-120</posx>
                    <visible>!Skin.HasSetting(Disable.HolidayTheme.AdditionalIcons)</visible>
                    <animation effect="rotate" end="15" time="9000" delay="45000" pulse="true" condition="true">Conditional</animation>
                    <control type="image">
                        <posx>-120</posx>
                        <posy>200</posy>
                        <width>64</width>
                        <height>64</height>
                        <texture flipx="true">special://skin/extras/backgrounds/holiday/$VAR[Path_HolidayMode]/santa-claus.png</texture>
                        <aspectratio scalediffuse="false">keep</aspectratio>
                        <animation effect="slide" start="0,0" end="2220,0" time="9000" delay="45000" reversible="false" loop="true" condition="true">Conditional</animation>
                        <animation effect="slide" start="0,10" end="0,100" time="9000" delay="45000" reversible="false" pulse="true" condition="true">Conditional</animation>
                    </control>
                </control>
                <control type="group">
                    <animation effect="slide" start="60,0" end="-60,0" time="10000" condition="true" reversible="false" pulse="true">Conditional</animation>
                    <animation effect="fade" end="20" condition="true">Conditional</animation>
                    <control type="image">
                        <texture flipx="true" flipy="true" colordiffuse="main_fg_70">special://skin/extras/backgrounds/holiday/$VAR[Path_HolidayMode]/snow_loop.png</texture>
                        <width>2430</width>
                        <aspectratio>keep</aspectratio>
                        <animation effect="slide" time="30000" start="0,0" end="0,1080" condition="true" loop="true">Conditional</animation>
                    </control>
                    <control type="image">
                        <texture flipx="true" flipy="true" colordiffuse="main_fg_70">special://skin/extras/backgrounds/holiday/$VAR[Path_HolidayMode]/snow_loop.png</texture>
                        <width>2430</width>
                        <aspectratio>keep</aspectratio>
                        <animation effect="slide" time="30000" start="0,-1080" end="0,0" condition="true" loop="true">Conditional</animation>
                    </control>
                </control>
