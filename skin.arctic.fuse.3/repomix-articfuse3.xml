                    <aspectratio>keep</aspectratio>
                    <height>48</height>
                    <width>71</width>
                    <centertop>50%</centertop>
                    <visible>!String.IsEmpty($PARAM[infolabel_videocodec])</visible>
                </control>
                <control type="image">
                    <texture background="true" colordiffuse="$PARAM[colordiffuse]">$INFO[$PARAM[infolabel_audiocodec],flags/color/audio/,.png]</texture>
                    <aspectratio>keep</aspectratio>
                    <height>48</height>
                    <width>71</width>
                    <centertop>50%</centertop>
