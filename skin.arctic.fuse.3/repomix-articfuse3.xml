<includes>

    <include name="Info_Meta_Object">
        <param name="font">font_main</param>
        <param name="colordiffuse">main_fg</param>
        <param name="icon_w">32</param>
        <param name="bordersize">0</param>
        <param name="max_width">680</param>
        <definition>
            <control type="image">
                <width>$PARAM[icon_w]</width>
                <height>32</height>
                <aspectratio>keep</aspectratio>
                <centertop>50%</centertop>
                <texture colordiffuse="$PARAM[colordiffuse]_90">$PARAM[icon]</texture>
                <visible>$PARAM[visible]</visible>
                <bordersize>$PARAM[bordersize]</bordersize>
            </control>
            <control type="label">
                <left>$PARAM[bordersize]</left>
                <aligny>center</aligny>
                <label>$PARAM[label]</label>
                <textcolor>$PARAM[colordiffuse]_70</textcolor>
                <font>$PARAM[font]</font>
                <visible>$PARAM[visible]</visible>
                <width max="$PARAM[max_width]">auto</width>
                <textoffsetx>0</textoffsetx>
                <texturefocus />
                <texturenofocus />
            </control>
            <control type="group">
                <visible>$PARAM[visible]</visible>
                <width>-4</width>
            </control>
        </definition>
    </include>

