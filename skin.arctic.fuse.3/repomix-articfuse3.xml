    <include name="Object_Indicator">
        <param name="affix" />
        <param name="listitem">ListItem</param>
        <param name="selected">false</param>
        <param name="shadow">true</param>
        <param name="backing">true</param>
        <definition>
            <control type="group">
                <nested />
                <centerbottom>0</centerbottom>
                <right>25</right>
                <width>64</width>
                <height>64</height>

                <!-- Visibility of Group -->
                <include content="Object_Indicator_Visible">
                    <param name="listitem">$PARAM[listitem]</param>
                </include>

                <!-- Focused Item -->
                <include content="Object_Indicator_Selected" condition="$PARAM[selected]">
                    <param name="shadow">$PARAM[shadow]</param>
                    <param name="listitem">$PARAM[listitem]</param>
                </include>

                <!-- Black Circle Backing -->
                <include content="Object_Control" condition="$PARAM[backing]">
                    <param name="control">image</param>
                    <texture colordiffuse="ff333333">indicator/circle-colordiffuse.png</texture>
                </include>

                <!-- Percentage -->
                <include content="Object_Control">
                    <param name="control">image</param>
                    <texture colordiffuse="$VAR[ColorWatchedProgress]" diffuse="indicator/circle-diffuse.png" background="true" flipx="true" flipy="true">$VAR[Defs_PercentPlayed$PARAM[affix],progress/circle/p,.png]</texture>
                    <aspectratio align="center" aligny="center">keep</aspectratio>
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Percentage</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                </include>

                <!-- Episodes Count -->
                <include content="Object_Control" condition="!Skin.HasSetting(Indicator.DisableEpisodes)">
                    <param name="control">label</param>
                    <font>font_hint_bold</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>panel_fg_100</textcolor>
                    <label>$INFO[$PARAM[listitem].Property(UnWatchedEpisodes)]</label>
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Episodes</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                </include>

                <!-- Timers -->
                <control type="group">
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Timers</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                    <control type="image">
                        <bordersize>20</bordersize>
                        <texture>indicator/record.png</texture>
                        <visible>$PARAM[listitem].IsRecording</visible>
                    </control>
                    <control type="image">
                        <bordersize>20</bordersize>
                        <texture>indicator/timer.png</texture>
                        <visible>!$PARAM[listitem].IsRecording</visible>
                        <visible>$PARAM[listitem].HasTimer</visible>
                    </control>
                </control>

                <!-- Progress -->
                <include content="Object_Control" condition="!Skin.HasSetting(Indicator.DisableProgress)">
                    <param name="control">image</param>
                    <bordersize>20</bordersize>
                    <texture>indicator/timer.png</texture>
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Progress</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                </include>

                <!-- Watched -->
                <include content="Object_Control" condition="!Skin.HasSetting(Indicator.DisableWatched)">
                    <param name="control">group</param>
                    <control type="image">
                        <texture colordiffuse="$VAR[ColorWatchedProgress]" diffuse="indicator/circle-diffuse.png" background="true" flipx="true" flipy="true">progress/circle/p100.png</texture>
                        <aspectratio align="center" aligny="center">keep</aspectratio>
                    </control>
                    <control type="image">
                        <bordersize>20</bordersize>
                        <texture colordiffuse="$VAR[ColorWatchedProgress]">indicator/checkmark.png</texture>
                    </control>
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Watched</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                </include>

                <!-- Library -->
                <include content="Object_Control" condition="!Skin.HasSetting(Indicator.DisableLibrary)">
                    <param name="control">image</param>
                    <bordersize>20</bordersize>
                    <texture>indicator/library.png</texture>
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Library</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                </include>

                <!-- Collection -->
                <include content="Object_Control" condition="!Skin.HasSetting(Indicator.DisableCollection)">
                    <param name="control">image</param>
                    <bordersize>20</bordersize>
                    <texture>indicator/movieset.png</texture>
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Collection</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                </include>

                <!-- Playing -->
                <include content="Object_Control" condition="True">
                    <param name="control">group</param>
                    <control type="image">
                        <bordersize>20</bordersize>
                        <texture>indicator/play.png</texture>
                    </control>
                    <include content="Object_Indicator_Visible">
                        <param name="include_type">Playing</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                </include>

            </control>
        </definition>
    </include>

