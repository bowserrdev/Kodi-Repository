<file path="1080i/Includes_Layouts.xml">
<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Layout_BasicMeta">
        <param name="selected">false</param>
        <definition>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <control type="group">
                    <centertop>50%</centertop>
                    <height>50</height>
                    <control type="image">
                        <centerleft>-20</centerleft>
                        <centertop>50%</centertop>
                        <width>10</width>
                        <height>10</height>
                        <texture border="4" colordiffuse="$VAR[ColorHighlight]">common/scrollv.png</texture>
                        <visible>$PARAM[selected]</visible>
                    </control>
                    <control type="label">
                        <top>0</top>
                        <height>20</height>
                        <font>font_main_bold</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>dialog_fg_90</textcolor>
                    </control>
                    <control type="label">
                        <bottom>0</bottom>
                        <height>20</height>
                        <font>font_mini</font>
                        <textcolor>dialog_fg_70</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                        <haspath>true</haspath>
                    </control>
                </control>
                <control type="group">
                    <left>-40</left>
                    <right>-40</right>
                    <include>Part_Line</include>
                </control>
            </control>
        </definition>
    </include>

    <include name="Layout_ViewType">
        <param name="selected">false</param>
        <param name="current">ListItem.IsSelected</param>
        <param name="icon">$INFO[ListItem.Icon]</param>
        <definition>
            <control type="group">
                <left>-740</left>
                <right>740</right>
                <control type="group">
                    <include content="Dimension_Padding">
                        <param name="pad">20</param>
                    </include>
                    <control type="image">
                        <aspectratio>scale</aspectratio>
                        <texture background="true" diffuse="diffuse/landscape_w1040_h585.png">$PARAM[icon]</texture>
                    </control>
                    <include content="Object_SelectBox" condition="$PARAM[selected]">
                        <param name="indicator">false</param>
                        <param name="focusbounce">true</param>
                    </include>

                    <include content="Object_Control" condition="$PARAM[selected]">
                        <param name="control">group</param>
                        <visible>$PARAM[current]</visible>
                        <centerbottom>0</centerbottom>
                        <right>25</right>
                        <width>64</width>
                        <height>64</height>

                        <!-- Focused Item -->
                        <include content="Object_Indicator_Selected">
                            <param name="shadow">false</param>
                        </include>

                        <!-- Black Circle Backing -->
                        <control type="image">
                            <texture colordiffuse="ff333333">indicator/circle-colordiffuse.png</texture>
                        </control>

                        <control type="image">
                            <texture colordiffuse="$VAR[ColorWatchedProgress]" diffuse="indicator/circle-diffuse.png" background="true" flipx="true" flipy="true">progress/circle/p100.png</texture>
                            <aspectratio align="center" aligny="center">keep</aspectratio>
                        </control>
                        <control type="image">
                            <bordersize>20</bordersize>
                            <texture colordiffuse="$VAR[ColorWatchedProgress]">indicator/checkmark.png</texture>
                        </control>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="Layout_MenuList_Labels">
        <control type="group">
            <control type="label">
                <include condition="$PARAM[selected]">Color_SelectedText</include>
                <textoffsetx>40</textoffsetx>
                <textcolor>$PARAM[textcolor]_70</textcolor>
                <selectedcolor>$PARAM[textcolor]_70</selectedcolor>
                <label>$INFO[ListItem.Label]</label>
                <visible>$PARAM[detailed]</visible>
            </control>
            <control type="label">
                <include condition="$PARAM[selected]">Color_SelectedText</include>
                <align>right</align>
                <textoffsetx>40</textoffsetx>
                <textcolor>$PARAM[textcolor]_70</textcolor>
                <selectedcolor>$PARAM[textcolor]_70</selectedcolor>
                <label>$INFO[ListItem.Label2]</label>
                <visible>$PARAM[detailed]</visible>
            </control>


            <control type="label">
                <include condition="$PARAM[selected]">Color_SelectedText</include>
                <textoffsetx>40</textoffsetx>
                <textcolor>$PARAM[textcolor]_70</textcolor>
                <selectedcolor>$PARAM[textcolor]_70</selectedcolor>
                <label>$INFO[ListItem.Label]</label>
                <visible>!$PARAM[detailed]</visible>
                <left>40</left>
            </control>
        </control>
    </include>

    <include name="Layout_MenuList_Icon">
        <control type="group">
            <centerleft>40</centerleft>
            <centertop>50%</centertop>
            <width>40</width>
            <height>40</height>
            <visible>![$PARAM[detailed]]</visible>
            <control type="image">
                <bordersize>icon_home_bordersize</bordersize>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <visible>String.IsEmpty(ListItem.Icon) | String.StartsWith(ListItem.Icon,special://skin/extras/icons)</visible>
                <include content="Object_ColorDiffuse" condition="$PARAM[selected]">
                    <param name="colordiffuse">$VAR[ColorSelected]</param>
                </include>
                <colordiffuse>$PARAM[textcolor]_70</colordiffuse>
                <texture background="true" diffuse="diffuse/circle/circle_120.png">$INFO[ListItem.Icon]</texture>
            </control>
            <control type="image">
                <bordersize>icon_main_bordersize</bordersize>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <visible>String.StartsWith(ListItem.Icon,Default)</visible>
                <include content="Object_ColorDiffuse" condition="$PARAM[selected]">
                    <param name="colordiffuse">$VAR[ColorSelected]</param>
                </include>
                <colordiffuse>$PARAM[textcolor]_70</colordiffuse>
                <texture background="true" diffuse="diffuse/circle/circle_120.png">$INFO[ListItem.Icon]</texture>
            </control>
            <control type="image">
                <bordersize>icon_item_bordersize</bordersize>
