<file path="1080i/Includes_Animations.xml">
<?xml version="1.0" encoding="UTF-8"?>
<includes>


    <!-- ============== -->
    <!-- OSD Animations -->
    <!-- ============== -->

    <!-- Transitions for Dialogs -->
    <include name="Animation_OSD_Dialog_WindowChange">
        <animation type="WindowOpen" reversible="false">
            <effect type="fade" start="0" end="100" time="200" delay="200" tween="sine" easing="out"/>
        </animation>
        <animation type="WindowClose" reversible="false">
            <effect type="fade" start="100" end="0" time="200" delay="0" tween="sine" easing="out"/>
        </animation>
    </include>
    <include name="Animation_OSD_Dialog_VisibleChange">
        <animation type="Visible" reversible="false">
            <effect type="fade" start="0" end="100" time="200" delay="200" tween="sine" easing="out"/>
        </animation>
        <animation type="Hidden" reversible="false">
            <effect type="fade" start="100" end="0" time="200" delay="0" tween="sine" easing="out"/>
        </animation>
    </include>

    <include name="Animation_OSD_HideForInfoDialog">
        <visible>!Window.IsActive(1193)</visible>
        <visible>!$EXP[Exp_InfoDialogs]</visible>
        <include content="Animation_Zoom_Out">
            <param name="type">Hidden</param>
        </include>
        <include content="Animation_Zoom_In">
            <param name="type">Visible</param>
            <param name="delay">200</param>
        </include>
    </include>

    <!-- Slide Expansions for Seekbar -->
    <include name="Animation_OSD_Seekbar_Slide">
        <animation effect="slide" start="0" end="0,80" time="300" tween="sine" easing="inout" condition="![Window.IsVisible(videoosd) | Window.IsVisible(musicosd) | $EXP[Exp_OSD_HideControls]]">Conditional</animation>
    </include>
    <include name="Animation_OSD_MusicArtwork_Slide">
        <animation effect="slide" start="0" end="0,160" time="300" tween="sine" easing="inout" condition="![Window.IsVisible(DialogSeekBar.xml)]">Conditional</animation>
        <animation effect="slide" start="0" end="0,80" time="300" tween="sine" easing="inout" condition="![Window.IsVisible(musicosd) | Window.IsVisible(script-cu-lrclyrics-main.xml)]">Conditional</animation>
    </include>

    <!-- Fullscreen Window Changes -->
    <include name="Animation_OSD_Fullscreen_Change">
        <animation effect="fade" start="0" end="100" time="300">VisibleChange</animation>
    </include>

    <!-- ==== -->
    <!-- Busy -->
    <!-- ==== -->
    <include name="Animation_Busy_Fade">
        <param name="end">20</param>
        <definition>
            <animation effect="fade" start="100" end="$PARAM[end]" time="200" condition="Container($PARAM[id]).IsUpdating">Conditional</animation>
        </definition>
    </include>


    <!-- ======== -->
    <!-- Standard -->
    <!-- ======== -->

    <!-- Zoom Animations -->
    <include name="Animation_Zoom_In">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="reversible">false</param>
        <param name="delay">0</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[delay]" tween="sine" easing="in" />
                <effect type="zoom" start="85" end="100" time="300" delay="$PARAM[delay]" center="auto" tween="sine" easing="out" />
            </animation>
        </definition>
    </include>
    <include name="Animation_Zoom_Out">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="reversible">false</param>
        <param name="delay">0</param>
        <param name="amount">85</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="zoom" start="100" end="$PARAM[amount]" center="auto" tween="sine" delay="$PARAM[delay]" easing="out" time="300" />
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" delay="$PARAM[delay]" time="300" />
            </animation>
        </definition>
    </include>

    <include name="_Animation_Widget_FadeOut">
        <param name="end">30</param>
        <definition>
            <animation effect="fade" start="100" end="$PARAM[end]" time="200" condition="$PARAM[condition]">Conditional</animation>
        </definition>
    </include>

    <include name="Animation_Widget_FadeOut">
        <param name="condition">true</param>
        <definition>
            <include content="_Animation_Widget_FadeOut">
                <param name="end">30</param>
                <param name="condition">$PARAM[condition]</param>
            </include>
        </definition>
    </include>

    <!-- Slide Animations -->
    <include name="Animation_Slide_In">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="delay">0</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <param name="reversible">false</param>
        <param name="slide_tween">cubic</param>
        <param name="slide_easing">out</param>
        <param name="time">400</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[delay]" tween="sine" easing="out"/>
                <effect type="slide" start="$PARAM[posx],$PARAM[posy]" end="0" time="$PARAM[time]" delay="$PARAM[delay]" tween="$PARAM[slide_tween]" easing="$PARAM[slide_easing]" />
            </animation>
        </definition>
    </include>
    <include name="Animation_Slide_Out">
        <param name="type">Conditional</param>
        <param name="condition">true</param>
        <param name="delay">0</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <param name="reversible">false</param>
        <param name="slide_tween">cubic</param>
        <param name="slide_easing">out</param>
        <definition>
            <animation type="$PARAM[type]" reversible="$PARAM[reversible]" condition="$PARAM[condition]">
                <effect type="fade" start="100" end="0" time="300" delay="$PARAM[delay]" tween="sine" easing="out"/>
                <effect type="slide" start="0" end="$PARAM[posx],$PARAM[posy]" time="300" delay="$PARAM[delay]" tween="$PARAM[slide_tween]" easing="$PARAM[slide_easing]" />
            </animation>
        </definition>
    </include>

    <!-- Directional Slides -->
    <include name="Animation_Direction">
        <param name="windowopen_condition">true</param>
        <param name="windowclose_condition">true</param>
        <param name="delay">0</param>
        <param name="posx">0</param>
        <param name="posy">0</param>
        <definition>
            <include content="Animation_Slide_In">
                <param name="type">Visible</param>
                <param name="delay">$PARAM[delay]</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
            <include content="Animation_Slide_In">
                <param name="condition">$PARAM[windowopen_condition]</param>
                <param name="type">WindowOpen</param>
                <param name="delay">$PARAM[delay]</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
            <include content="Animation_Slide_Out">
                <param name="type">Hidden</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
            <include content="Animation_Slide_Out">
                <param name="condition">$PARAM[windowclose_condition]</param>
                <param name="type">WindowClose</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Direction_Delay">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="delay">400</param>
                <param name="posx">$PARAM[posx]</param>
                <param name="posy">$PARAM[posy]</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Right">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Right_Delay">
        <definition>
            <include content="Animation_Direction_Delay">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Left">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">-320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Left_Delay">
        <definition>
            <include content="Animation_Direction_Delay">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posx">-320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Down">
        <definition>
            <include content="Animation_Direction">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posy">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_Down_Delay">
        <definition>
            <include content="Animation_Direction_Delay">
                <param name="windowopen_condition">$PARAM[windowopen_condition]</param>
                <param name="windowclose_condition">$PARAM[windowclose_condition]</param>
                <param name="posy">320</param>
            </include>
        </definition>
    </include>

    <include name="Animation_View_WindowChange">
        <param name="windowopen_condition">!$EXP[Exp_PlainBackgroundWindows_Prev]</param>
        <param name="windowclose_condition">!$EXP[Exp_PlainBackgroundWindows_Next]</param>
        <definition>
            <visible>!$EXP[Exp_InfoDialogs]</visible>
            <include content="Animation_Zoom_In">
                <param name="type">Visible</param>
            </include>
            <include content="Animation_Zoom_Out">
                <param name="type">Hidden</param>
            </include>
        </definition>
    </include>

    <!-- Conditional Fade to allow Include Conditions -->
    <include name="Animation_ConditionalFade">
        <param name="end">0</param>
        <param name="condition">true</param>
        <definition>
            <animation effect="fade" start="100" end="$PARAM[end]" condition="$PARAM[condition]">Conditional</animation>
        </definition>
    </include>

    <!-- Focus Bounce for Select Box -->
    <include name="Animation_FocusBounce">
        <animation type="Focus" reversible="false">
            <effect type="zoom" start="96.5" end="100" time="150" tween="sine" easing="inout" center="auto"/>
            <effect type="fade" start="20" end="100" time="150" tween="back" easing="out"/>
        </animation>
    </include>

    <include name="Animation_DialogInfoButton_ZoomIn">
        <animation type="WindowOpen" reversible="false">
            <effect type="zoom" start="20" end="100" delay="$PARAM[delay]" time="400" tween="back" easing="out" center="auto"/>
            <effect type="fade" start="0" end="100" delay="$PARAM[delay]" time="200" />
        </animation>
    </include>

    <!-- Standard Animations -->
    <include name="Animation_Fade_In">
        <param name="condition">true</param>
        <param name="type">Conditional</param>
        <param name="delay">0</param>
        <param name="time">400</param>
        <param name="reversible">false</param>
        <definition>
            <animation effect="fade" start="0" end="100" delay="$PARAM[delay]" time="$PARAM[time]" tween="sine" easing="in" reversible="$PARAM[reversible]" condition="$PARAM[condition]">$PARAM[type]</animation>
        </definition>
    </include>

    <include name="Animation_Fade_Out">
        <param name="condition">true</param>
        <param name="type">Conditional</param>
        <param name="delay">0</param>
        <param name="time">300</param>
        <param name="reversible">false</param>
        <definition>
            <animation effect="fade" start="100" end="0" delay="$PARAM[delay]" time="$PARAM[time]" tween="sine" easing="in" reversible="$PARAM[reversible]" condition="$PARAM[condition]">$PARAM[type]</animation>
        </definition>
    </include>


    <include name="Animation_FadeIn">
        <include content="Animation_Fade_In">
            <param name="type">Visible</param>
        </include>
        <include content="Animation_Fade_In">
            <param name="type">WindowOpen</param>
        </include>
    </include>

    <include name="Animation_FadeIn_Delay">
        <include content="Animation_Fade_In">
            <param name="type">Visible</param>
            <param name="delay">400</param>
        </include>
        <include content="Animation_Fade_In">
            <param name="type">WindowOpen</param>
            <param name="delay">400</param>
        </include>
    </include>

    <include name="Animation_FadeOut">
        <include content="Animation_Fade_Out">
            <param name="type">Hidden</param>
        </include>
        <include content="Animation_Fade_Out">
            <param name="type">WindowClose</param>
        </include>
    </include>

    <include name="Animation_BounceIn_Dialog">
        <param name="visible_delay">200</param>
        <param name="visible_condition">true</param>
        <param name="windowopen_delay">200</param>
        <param name="windowopen_condition">true</param>
        <param name="posy">-80</param>
        <definition>
            <animation type="Visible" reversible="false" condition="$PARAM[visible_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[visible_delay]"/>
                <effect type="slide" start="0,$PARAM[posy]" end="0" center="auto" tween="back" easing="out" time="600" delay="$PARAM[visible_delay]"/>
            </animation>
            <animation type="WindowOpen" reversible="false" condition="$PARAM[windowopen_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[windowopen_delay]"/>
                <effect type="slide" start="0,$PARAM[posy]" end="0" center="auto" tween="back" easing="out" time="600" delay="$PARAM[windowopen_delay]"/>
            </animation>
            <include content="Animation_Zoom_Out">
                <param name="type">Hidden</param>
                <param name="amount">95</param>
            </include>
            <include content="Animation_Zoom_Out">
                <param name="type">WindowClose</param>
                <param name="amount">95</param>
            </include>
        </definition>
    </include>

    <include name="Animation_SlideIn_Dialog">
        <param name="visible_delay">150</param>
        <param name="visible_condition">true</param>
        <param name="windowopen_delay">400</param>
        <param name="windowopen_condition">true</param>
        <param name="posy">-48</param>
        <definition>
            <animation type="Visible" reversible="false" condition="$PARAM[visible_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[visible_delay]"/>
                <effect type="slide" start="0,$PARAM[posy]" end="0" center="auto" tween="back" easing="out" time="400" delay="$PARAM[visible_delay]"/>
            </animation>
            <animation type="WindowOpen" reversible="false" condition="$PARAM[windowopen_condition]">
                <effect type="fade" start="0" end="100" time="300" delay="$PARAM[windowopen_delay]"/>
                <effect type="slide" start="0,$PARAM[posy]" end="0" center="auto" tween="back" easing="out" time="400" delay="$PARAM[windowopen_delay]"/>
            </animation>
        </definition>
    </include>

    <include name="Animation_Overlay_FadeIn">
        <param name="delay">0</param>
        <definition>
            <animation effect="fade" start="0" end="100" time="300" delay="$PARAM[delay]">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
        </definition>
    </include>

    <include name="Animation_Group_Bumper">
        <!-- Up (for ondown) -->
        <animation type="Conditional" condition="Window.IsVisible(1180) + [String.IsEmpty(Window(Home).Property(Bumper.Direction)) | String.IsEqual(Window(Home).Property(Bumper.Direction),Down)]" reversible="false">
            <effect type="slide" end="0,-20" time="60" tween="sine" />
            <effect type="slide" end="0,20" time="180" tween="sine" delay="80" />
        </animation>

        <!-- Right (for onleft) -->
        <animation type="Conditional" condition="Window.IsVisible(1180) + String.IsEqual(Window(Home).Property(Bumper.Direction),Left)" reversible="false">
            <effect type="slide" end="20" time="60" tween="sine" />
            <effect type="slide" end="-20" time="180" tween="sine" delay="80" />
        </animation>

        <!-- Left (for onright) -->
        <animation type="Conditional" condition="Window.IsVisible(1180) + String.IsEqual(Window(Home).Property(Bumper.Direction),Right)" reversible="false">
            <effect type="slide" end="-20" time="60" tween="sine" />
            <effect type="slide" end="20" time="180" tween="sine" delay="80" />
        </animation>

        <!-- Down (for onup) -->
        <animation type="Conditional" condition="Window.IsVisible(1180) + String.IsEqual(Window(Home).Property(Bumper.Direction),Up)" reversible="false">
            <effect type="slide" end="0,20" time="60" tween="sine" />
            <effect type="slide" end="0,-20" time="180" tween="sine" delay="80" />
        </animation>
    </include>

</includes>
</file>

<file path="1080i/Includes_Background.xml">
<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Background_BusyLoader">
        <control type="group">
            <visible>Window.IsVisible(DialogBusy.xml)</visible>
            <animation effect="fade" start="0" end="100" time="5000" tween="cubic" easing="inout" reversible="true">Visible</animation>
            <animation effect="fade" start="100" end="0" time="1000" tween="cubic" easing="inout" reversible="true">Hidden</animation>
            <control type="multiimage">
                <timeperimage>50</timeperimage>
                <aspectratio align="center" aligny="center">stretch</aspectratio>
                <fadetime>10</fadetime>
                <colordiffuse>55ffffff</colordiffuse>
                <imagepath>resource://resource.images.arctic.waves/</imagepath>
                <randomize>false</randomize>
            </control>
        </control>
    </include>

    <include name="Background_FlixArt">
        <param name="flixart_size_w">flixart_size_w</param>
        <param name="flixart_size_h">flixart_size_h</param>
        <param name="right">0</param>
        <param name="diffuse">diffuse/flixart/flixart.png</param>
        <param name="aspectratio">scale</param>
        <param name="fadetime">background_fadetime</param>
        <definition>
            <control type="image">
                <fadetime>$PARAM[fadetime]</fadetime>
                <right>$PARAM[right]</right>
                <top>0</top>
                <height>$PARAM[flixart_size_h]</height>
                <width>$PARAM[flixart_size_w]</width>
                <aspectratio scalediffuse="false" align="$PARAM[align]" aligny="$PARAM[aligny]">$PARAM[aspectratio]</aspectratio>
                <texture background="true" diffuse="$PARAM[diffuse]">$VAR[Image_Foreground]</texture>
                <animation effect="fade" start="100" end="0" reversible="false" time="300" condition="$EXP[Exp_BackgroundArtwork_IsHidden]">Conditional</animation>
                <animation effect="fade" start="0" end="100" reversible="false" delay="300" time="background_fadetime" condition="!$EXP[Exp_BackgroundArtwork_IsHidden]">Conditional</animation>
                <include>Background_NotVideo</include>
            </control>
        </definition>
    </include>

    <include name="Background_Artwork">
        <param name="fadetime">background_fadetime</param>
        <definition>
            <include content="Background_FlixArt" condition="$EXP[Exp_TMDbHelper_IsBlur]">
                <param name="fadetime">$PARAM[fadetime]</param>
            </include>
            <include content="Background_FlixArt" condition="!$EXP[Exp_TMDbHelper_IsBlur]">
                <param name="fadetime">$PARAM[fadetime]</param>
                <param name="diffuse">diffuse/flixart/flixart_new.png</param>
            </include>
        </definition>
    </include>

    <include name="Background_Blur_Quadrants">
        <control type="group">
            <top>0</top>
            <right>0</right>
            <width>$PARAM[flixart_size_w]</width>
            <height>$PARAM[flixart_size_h]</height>
            <control type="image">
                <top>0</top>
                <right>0</right>
                <width>200%</width>
                <height>200%</height>
                <fadetime>$PARAM[fadetime]</fadetime>
                <aspectratio>scale</aspectratio>
                <texture background="true">$VAR[Image_Background,,-tiled.jpg]</texture>
            </control>
        </control>
    </include>

    <include name="Background_Blur">
        <param name="flixart_size_w">flixart_size_w</param>
        <param name="flixart_size_h">flixart_size_h</param>
        <param name="fadetime">background_fadetime</param>
        <definition>
            <control type="group">
                <include>Background_NotVideo</include>
                <include content="Background_Blur_Quadrants" condition="$EXP[Exp_TMDbHelper_IsBlur]">
                    <param name="flixart_size_w">$PARAM[flixart_size_w]</param>
                    <param name="flixart_size_h">$PARAM[flixart_size_h]</param>
                    <param name="fadetime">$PARAM[fadetime]</param>
                </include>
                <include content="Background_Image" condition="!$EXP[Exp_TMDbHelper_IsBlur]">
                    <param name="fadetime">$PARAM[fadetime]</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="Background_StartUp">
        <param name="colordiffuse">main_back</param>
        <definition>
            <control type="image">
                <texture colordiffuse="$VAR[ColorBackground]">common/white.png</texture>
            </control>
            <control type="multiimage">
                <imagepath colordiffuse="$PARAM[colordiffuse]">$VAR[Image_StartUp]</imagepath>
                <randomize>true</randomize>
                <timeperimage>5000</timeperimage>
                <fadetime>2000</fadetime>
                <aspectratio>scale</aspectratio>
            </control>
        </definition>
    </include>

    <include name="Background_Image">
        <param name="texture">$VAR[Image_SimpleBackground]</param>
        <definition>
            <control type="image">
                <fadetime>$PARAM[fadetime]</fadetime>
                <aspectratio align="left">scale</aspectratio>
                <texture background="true">$PARAM[texture]</texture>
                <include>Background_NotVideo</include>
            </control>
        </definition>
    </include>

    <include name="Background_NotVideo">
        <param name="fade_end">0</param>
        <definition>
            <visible>$EXP[Exp_Video_IsNotPlaying]</visible>
            <animation effect="fade" start="100" end="0" time="400" tween="sine" easing="in" reversible="false">Hidden</animation>
            <animation effect="fade" start="0" end="100" time="400" tween="sine" easing="in" reversible="false">Visible</animation>
        </definition>
    </include>

    <include name="Background_Video_Offscreen">
        <control type="group">
            <description>Off-screen videowindow for avoiding sync issues</description>
            <control type="videowindow">
                <description>Hide behind background</description>
                <visible>!Window.IsVisible(1123)</visible>
            </control>
            <control type="image">
                <texture colordiffuse="black">common/white.png</texture>
            </control>
        </control>
    </include>

    <include name="Background_Video">
        <control type="group">
            <description>On-screen videowindow for background video</description>
            <control type="videowindow">
                <visible>!Window.IsVisible(1123)</visible>
            </control>
            <control type="visualisation">
                <visible>!Window.IsVisible(1123)</visible>
            </control>
            <control type="image">
                <texture colordiffuse="black">diffuse/flixart/flixart_invert.png</texture>
            </control>
        </control>
    </include>

    <include name="Background_Video_FlixArt">
        <control type="group">
            <description>On-screen videowindow for background video</description>
            <control type="group">
                <top>0</top>
                <height>flixart_size_h</height>
                <visible>![$EXP[Exp_Video_IsNotPlaying]]</visible>
                <control type="videowindow">
                    <right>0</right>
                    <width>flixart_size_w</width>
                    <visible>!Window.IsVisible(1123)</visible>
                </control>
                <control type="visualisation">
                    <right>0</right>
                    <width>flixart_size_w</width>
                    <visible>!Window.IsVisible(1123)</visible>
                </control>
                <control type="image">
                    <right>0</right>
                    <width>flixart_size_w</width>
                    <texture colordiffuse="black">diffuse/flixart/flixart_invert.png</texture>
                </control>
                <control type="image">
                    <left>0</left>
                    <right>flixart_size_w</right>
                    <texture colordiffuse="black">common/white.png</texture>
                </control>
            </control>
            <control type="image">
                <top>flixart_size_h</top>
                <texture colordiffuse="black">common/white.png</texture>
            </control>
        </control>
    </include>

    <include name="Background_Main_Plain">
        <control type="group">
            <description>Plain background used to prevent fadetime transitions</description>
            <include content="Background_Blur">
                <param name="fadetime">0</param>
            </include>
            <include content="Background_Artwork">
                <param name="fadetime">0</param>
            </include>
        </control>
    </include>

    <include name="Background_Main_Standard">
        <control type="group">
            <animation effect="fade" start="0" end="100" time="background_fadetime">Visible</animation>
            <animation effect="fade" start="100" end="0" time="background_fadetime">Hidden</animation>
            <include>Background_Blur</include>
            <include>Background_Artwork</include>
        </control>
    </include>

    <include name="Background_Main_Overlay">
        <include condition="System.HasAddon(resource.images.arctic.waves)">Background_BusyLoader</include>
        <control type="image">
            <texture colordiffuse="$VAR[ColorBackground]">special://skin/extras/backgrounds/overlay/combined_flixart.png</texture>
        </control>
        <control type="image">
            <texture colordiffuse="$VAR[ColorBackground]">special://skin/extras/backgrounds/overlay/combined_overlay.png</texture>

            <visible>$EXP[Exp_BackgroundArtwork_IsOverlay]</visible>

            <include content="Animation_Fade_In">
                <param name="type">Visible</param>
            </include>
            <include content="Animation_Fade_Out">
                <param name="type">Hidden</param>
            </include>
        </control>
    </include>

    <include name="Background_HolidayTheme_FrostOverlay">
        <control type="image">
            <texture background="true">special://skin/extras/backgrounds/holiday/winter/frost.png</texture>
            <aspectratio>stretch</aspectratio>
            <visible>$EXP[Exp_Christmas_Theme]</visible>
            <visible>!Skin.HasSetting(HolidayMode.Australia)</visible>
        </control>
    </include>

    <include name="Background_Main_Zoomer">
        <animation type="Conditional" condition="$PARAM[condition]">
            <effect type="zoom" start="100" end="flixart_zoom_p" center="100%,0" time="400" tween="sine" easing="inout" />
        </animation>
    </include>

    <include name="Background_Main">
        <param name="plain_background">false</param>
        <param name="video_background">!Skin.HasSetting(Background.DisableVideo)</param>
        <param name="include_layer">Object_Null</param>
        <param name="condition_zoomer">[!$EXP[Exp_InfoDialogs] + $EXP[Hub_Spotlight_Visible_Expression]]</param>
        <param name="include_zoomer">Window.IsVisible(Home) | Window.IsVisible(1101) | Window.IsVisible(1102) | Window.IsVisible(1103) | Window.IsVisible(1104)</param>
        <definition>
            <include condition="![$PARAM[video_background]]">Background_Video_Offscreen</include>
            <include condition="$PARAM[video_background]">Background_Video</include>

            <control type="group">
                <include content="Background_Main_Zoomer" condition="$PARAM[include_zoomer]">
                    <param name="condition">$PARAM[condition_zoomer]</param>
                </include>
                <include condition="$PARAM[plain_background]">Background_Main_Plain</include>
                <include condition="!$PARAM[plain_background]">Background_Main_Standard</include>
            </control>
            <include>$PARAM[include_layer]</include>
            <include>Background_Main_Overlay</include>
            <include condition="Skin.HasSetting(EnableHolidayTheme) + Skin.HasSetting(HolidayMode.Frost)">Background_HolidayTheme_FrostOverlay</include>
        </definition>
    </include>

    <include name="Background">
        <param name="plain_background">$EXP[Exp_PlainBackgroundWindows]</param>
        <definition>

            <!-- Standard Background -->
            <include condition="!$EXP[Exp_PlainBackgroundWindows]">Background_Main</include>

            <!-- Plain Background -->
            <include content="Background_Main" condition="$EXP[Exp_PlainBackgroundWindows]">
                <param name="plain_background">true</param>
            </include>
        </definition>

    </include>

</includes>
</file>

<file path="1080i/Includes_ButtonMenu.xml">
<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="ButtonMenu_MediaControls">

        <item>
            <label>$LOCALIZE[559]</label>
            <icon>special://skin/extras/icons/playlist.png</icon>
            <onclick>Action(Back)</onclick>
            <onclick condition="Integer.IsGreater(Playlist.Length(video),0) + [Player.HasVideo | Integer.IsEqual(Playlist.Length(music),0)]">ActivateWindow(videoplaylist)</onclick>
            <onclick condition="Integer.IsGreater(Playlist.Length(music),0) + !Player.HasVideo">ActivateWindow(musicplaylist)</onclick>
            <!-- <visible>[Integer.IsGreater(Playlist.Length(video),0) + [Player.HasVideo | Integer.IsEqual(Playlist.Length(music),0)]] | [Integer.IsGreater(Playlist.Length(music),0) + !Player.HasVideo]</visible> -->
        </item>

        <item>
            <label>$LOCALIZE[31579]</label>
            <icon>special://skin/extras/icons/backward-step.png</icon>
            <onclick>PlayerControl(Previous)</onclick>
            <!-- <visible>Player.HasAudio</visible> -->
        </item>

        <item>
            <label>$VAR[Label_OSD_PausePlay]</label>
            <icon>$VAR[Image_OSD_PausePlay]</icon>
