    <expression name="Exp_FurnitureBusy_AnimationCond_DialogVolumeBar">[Window.IsActive(DialogExtendedProgressBar.xml) | Window.IsActive(DialogNotification.xml) | Window.IsActive(DialogBusy.xml)]</expression>

    <!-- ================= -->
