<include content="Hub_Combined_Widget">
    <param name="id">{widget_id}</param>
    <!-- Le righe di ricerca vivono solo in Custom_1105_Search: il token di paginazione va letto nello
         scope 1105, che e' quello in cui il lato plugin lo scrive (paginator.ctl_scope). Senza, vale il
         default 'home' di Hub_Combined_Widget e il contenitore leggerebbe il token della Home. -->
    <param name="pgscope">1105</param>
    <!-- pggated: il path e' vuoto a casella vuota, quindi il segmento di identita' non va accodato dopo ma
         sta dentro la variabile del path, dove sparisce insieme a lui. Senza, il contenitore resterebbe con il
         solo '&amp;pgctl=1105.502' e Kodi lo tenterebbe come cartella. -->
    <param name="pggated">true</param>
    <!-- LOTTO 419: il path e' quello della regola generata (search_regola.xmltemplate), con l'attesa e il gettone
         dentro la variabile: a casella vuota la variabile non ha valore, e il contenitore resta senza path.
         'vuota=segnaposto' e' dentro anche lui: una riga che ha finito senza risultati lo DICE
         (kodi_utils.STATO_VUOTO) invece di restare a zero elementi, muta. -->
    <param name="content">$VAR[Search_Path_{widget_id}]</param>
    <param name="pagine">false</param>
    <param name="include">{widget_include}</param>
    <param name="target">{widget_target}</param>
    <param name="sortby">{widget_sortby}</param>
    <param name="sortorder">{widget_sortorder}</param>
    <param name="limit">{widget_limit}</param>
    <!-- LOTTO 419, LO SCHERMO DECIDE ANCHE QUI. La riga c'e' se e' quella della linguetta scelta e non ha risposto
         "niente" alla query scritta adesso (Exp_Search_N_Vuota). Mentre mostra i risultati di un'altra query
         (Exp_Search_N_AltraLista) e' gia' in attesa: il rilevatore (Riga_Attesa, parametro identita) nasconde gli
         elementi vecchi e mostra i segnaposto, e il path chiede il solo segnaposto (attesa=1); arrivato quello, la
         costruzione riparte dal primo elemento. Prima (lotto 338, step 4) la riga restava NASCOSTA finche' i suoi
         elementi non erano della query scritta, e il plugin la distruggeva dal ponte (router._svuota_prima):
         niente segnaposto a schermo, la scritta "Ricerca in corso" al loro posto, e una seconda regola dei
         segnaposto solo per la ricerca. RIPOSIZIONAMENTO.md, *Lotto 419*.
         (Lotto 165 ritirato il 21/09: qui c'era anche il cancello della coda del riposizionamento,
         fenlight.pg.rehead, che non esiste piu'. tests/ritirati/test_rehead_ricerca.py) -->
    <param name="visible">String.IsEqual(Container(601).ListItem.Property(guid),{widget_guid}) + ![$EXP[Exp_Search_{widget_id}_Vuota]]</param>
    <param name="identita">!$EXP[Exp_Search_{widget_id}_AltraLista]</param>
    <param name="allowhiddenfocus">true</param>
    <param name="hidden_button_enabled">true</param>
</include>
