<item>
    <label>{item_label}</label>
    <icon>{item_icon}</icon>
    <property name="guid">{item_guid}</property>
    <property name="widget_id">$NUMBER[{widget_id}]</property>
    <property name="show_artwork">true</property>
    <property name="widget_numitems">$INFO[Container({widget_id}).NumItems]</property>
    <!-- LOTTO 419: la riga sta caricando altre pagine (search_regola.xmltemplate). La legge la rotellina della
         striscia (Exp_Search_Row_Spinner) dalla linguetta scelta: e' la riga a schermo, e le righe nascoste
         non si aggiornano. Cosi' nessuna espressione deve elencare gli id delle righe. -->
    <property name="pagina">$VAR[Search_Pagina_{widget_id}]</property>
    <!-- LOTTO 419: la linguetta c'e' se la casella ha testo e la sua riga NON ha risposto "niente" alla query
         scritta adesso (Exp_Search_N_Vuota, generata). C'e' quindi subito, anche mentre la riga aspetta: la riga
         mostra i segnaposto. Prima (lotto 338, step 4) compariva solo quando la riga aveva TITOLI della query
         scritta, e "Ricerca in corso" copriva l'attesa. Da questa visible dipendono la linea sotto le linguette,
         la freccia giu' verso 601 e "Nessun risultato": leggono Container(601).NumItems. -->
    <visible>!String.IsEmpty(Control.GetLabel(3000).index(1)) + ![$EXP[Exp_Search_{widget_id}_Vuota]]</visible>
</item>
