<item>
    <label>{item_label}</label>
    <icon>{item_icon}</icon>
    <property name="guid">{item_guid}</property>
    <property name="widget_id">$NUMBER[{widget_id}]</property>
    <property name="show_artwork">true</property>
    <property name="widget_numitems">$INFO[Container({widget_id}).NumItems]</property>
    <visible>!String.IsEmpty(Control.GetLabel(3000).index(1))</visible>
    <!-- Stesso cancello della riga (search_row.xmltemplate): la linguetta esiste solo se il primo elemento
         della SUA riga porta la query scritta adesso, il che implica anche che la riga ha elementi. Con il
         solo NumItems restava accesa, al cambio di query, con il nome dei risultati vecchi (19/09). Da
         questa visible dipendono anche la linea sotto le linguette e la freccia giu' verso 601: leggono
         Container(601).NumItems. -->
    <!-- STEP 4: e il segnaposto non merita una linguetta. Lo porta anche lui, il timbro della query,
         quindi senza questo termine una riga che ha risposto "niente" avrebbe comunque il suo nome
         in cima, e da Container(601).NumItems dipende anche "Nessun risultato". -->
    <visible>String.IsEqual(Container({widget_id}).ListItemAbsolute(0).Property(fenlight.query),Control.GetLabel(3000).index(1)) + String.IsEmpty(Container({widget_id}).ListItemAbsolute(0).Property(fenlight.segnaposto))</visible>
</item>