<include content="Widget_Row">
    <param name="id">{widget_id}</param>
    <param name="groupid">{widget_group_id}</param>
    <param name="label">{widget_label}</param>
    <param name="include">{widget_include}</param>
        <!-- LOTTO 165 RITIRATO (21/09). Qui c'era anche
         !String.Contains(Window(Home).Property(fenlight.pg.rehead),1105.{widget_id}): la riga
         restava nascosta finche' il watcher non aveva riportato il contenitore in testa, perche'
         al cambio query Kodi teneva gli elementi vecchi e il cursore dove l'utente l'aveva
         lasciato. Con la costruzione vuota quel presupposto e' caduto: il contenitore passa
         SEMPRE dal vuoto prima di riempirsi, e un contenitore vuoto non ha nessuna posizione da
         riportare in testa (lo osservava gia' il commento di reconcile_position per Discover).
         E non era solo inutile: il watcher trovava il contenitore gia' in testa, aspettava i suoi
         3 secondi e mollava, e in quei 3 secondi il cancello teneva nascosta una riga che con la
         cache calda era pronta in 112 ms. Log del 21/09 06:19, sei volte in tre ricerche:
             06:19:11.373  svuoto prima di costruire key=1105.502 query="lust"
             06:19:15.270  watcher testa nuova key=1105.502: mollo dopo 3 s (fermo a 1/0)
         tests/test_rehead_ricerca.py -->
    <!-- IL SECONDO TERMINE MANCAVA, e la riga combinata ce l'ha da sempre (search_row.xmltemplate):
         la riga si mostra solo se i SUOI elementi sono della query scritta adesso. Qui la modalita'
         standard si reggeva sul solo segnaposto, cioe' su un meccanismo del lato plugin, mentre
         l'altra aveva due difese. Nessuno lo aveva deciso: e' la stessa deriva del lotto 167, dove
         un cancello entro' in un template e non nell'altro. La regola di identita' di una riga e'
         una sola e sta in Includes_Search.xml, espressione Exp_Search_<id>_Risponde; qui e' scritta
         per esteso perche' un $EXP definito in un altro file, se non si risolvesse, fallirebbe in
         silenzio rendendo la riga invisibile per sempre. Che le due scritture restino identiche lo
         verifica tests/test_regola_riga_unica.py. -->
    <param name="visible">[{widget_visible}] + String.IsEqual(Container({widget_id}).ListItemAbsolute(0).Property(fenlight.query),Control.GetLabel(3000).index(1)) + String.IsEmpty(Container({widget_id}).ListItemAbsolute(0).Property(fenlight.segnaposto))</param>
    <param name="altvisible">{widget_altvisible}</param>
    <param name="busy_isupdating">{widget_altvisible}</param>
    <param name="busy_visible">[Integer.IsEqual(Container({widget_id}).NumItems,0) | Container({widget_id}).IsUpdating]</param>
    <param name="widgetfade_include">true</param>
    <param name="widgetconstants_affix">_detailed</param>
    <param name="grouplistid">602</param>
    <param name="refocus">SetFocus(302)</param>

    <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
    <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>

    <description>{description}</description>

    <!-- Il <content> non si scrive piu' qui: vedi Defs_Widget_Content in Includes_Widgets.xml.
         Qui il path di base e' vuoto a casella vuota, quindi pgctl resta vuoto e il segmento va
         nel SUFFISSO del $VAR, dove sparisce insieme al path. -->
    <include content="Defs_Widget_Content">
        <param name="content">$VAR[{widget_search_variable},{widget_path},{widget_path_end}&amp;pgctl=1105.{widget_id}&amp;vuota=segnaposto]</param>
        <param name="pgctl" />
        <param name="pgscope">1105</param>
        <param name="id">{widget_id}</param>
        <param name="sortby">{widget_sortby}</param>
        <param name="sortorder">{widget_sortorder}</param>
        <param name="target">{widget_target}</param>
        <param name="limit">{widget_limit}</param>
    </include>

    <include content="Defs_AutoScroll" condition="{widget_isautoscroll}">
        <param name="condition">[!Control.HasFocus({widget_id}) | System.IdleTime(3)]</param>
    </include>
</include>
