<include content="Widget_Row">
    <param name="id">{widget_id}</param>
    <param name="groupid">{widget_group_id}</param>
    <param name="label">{widget_label}</param>
    <param name="include">{widget_include}</param>
    <!-- LOTTO 428: la finestra della riga, dove l'onfocus scrive TMDbHelper.WidgetContainer (Widget_Row) -->
    <param name="finestra">1105</param>
    <!-- LOTTO 419: la stessa regola della riga combinata (search_row.xmltemplate), dalle stesse espressioni
         generate (search_regola.xmltemplate): la riga c'e' se non ha risposto "niente" alla query scritta adesso,
         e mentre mostra i risultati di un'altra query e' in attesa (identita, Riga_Attesa). Prima la regola era
         scritta qui per esteso, copia di quella combinata (tests/test_regola_riga_unica.py), e la riga restava
         nascosta finche' non arrivavano i risultati: adesso si vedono i segnaposto.
         Qui non c'e' piu' busy_visible: Widget_Row passa sempre quello del rilevatore (Riga_Attesa), e quello
         scritto qui non lo leggeva nessuno. -->
    <param name="visible">[{widget_visible}] + ![$EXP[Exp_Search_{widget_id}_Vuota]]</param>
    <param name="identita">!$EXP[Exp_Search_{widget_id}_AltraLista]</param>
    <param name="altvisible">{widget_altvisible}</param>
    <param name="busy_isupdating">{widget_altvisible}</param>
    <param name="widgetfade_include">true</param>
    <param name="widgetconstants_affix">_detailed</param>
    <param name="grouplistid">602</param>
    <param name="refocus">SetFocus(302)</param>

    <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
    <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>

    <description>{description}</description>

    <!-- Il <content> non si scrive piu' qui: vedi Defs_Widget_Content in Includes_Widgets.xml.
         Il path e' la variabile della regola generata (search_regola.xmltemplate), che a casella vuota non ha
         valore: identita' (pgctl), 'vuota' e gettone stanno dentro di lei e spariscono con lei, quindi qui
         restano vuoti (prima 'vuota' finiva due volte nel path, e a casella vuota restava da solo). -->
    <include content="Defs_Widget_Content">
        <param name="content">$VAR[Search_Path_{widget_id}]</param>
        <param name="pgctl" />
        <param name="vuota" />
        <param name="pagine">false</param>
        <param name="pgscope">1105</param>
        <param name="id">{widget_id}</param>
        <param name="sortby">{widget_sortby}</param>
        <param name="sortorder">{widget_sortorder}</param>
        <param name="target">{widget_target}</param>
        <param name="limit">{widget_limit}</param>
    </include>

    <include content="Defs_AutoScroll" condition="{widget_isautoscroll}">
        <param name="condition">[!Control.HasFocus({widget_id}) | System.IdleTime(3)]</param>
    </include>
</include>
