{
    "infolabels": {
        "StartupReplaceWindow": "Window(Home).Property(StartupReplaceWindow)",
        "StartupWindow": "System.StartupWindow",
        "VideoPath": "Skin.String(Startup.VideoPath)"
    },
    "values": {
        "ReplaceWindowCommand": [
            {
                "rules": [
                    "{StartupReplaceWindow}!="
                ],
                "value": "ReplaceWindow({StartupReplaceWindow})"
            },
            "ReplaceWindow({StartupWindow})"
        ]
    },
    "actions": [
        [
            {
                "rules": [
                    "String.IsEmpty(Window.Property(ReloadDone))"
                ],
                "value": [
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Window.Property(ReloadDone))",
                                "!Skin.HasSetting(DefaultConfig.InitDone)"
                            ],
                            "value": [
                                "Skin.SetBool(TMDbHelper.EnableData)",
                                "Skin.SetBool(TMDbHelper.EnableCrop)",
                                "Skin.SetBool(TMDbHelper.EnableBlur)",
                                "Skin.SetString(Background.DialogImage,Adaptive)",
                                "Skin.SetString(Background.Image,resource://resource.images.arcticfuse/backgrounds/blur/purple_blur.jpg)",
                                "Skin.SetString(HomeSwitcher.Home.Shortcut.Path,ActivateWindow(1181))",
                                "Skin.SetString(HomeSwitcher.Home.Spotlight.Path,special://skin/extras/playlists/RandomMovies.xsp)",
                                "Skin.SetString(HomeSwitcher.Home.Spotlight.Target,videos)",
                                "Skin.SetString(HomeSwitcher.Home.Spotlight.Label,Random Movies)",
                                "Skin.SetBool(DefaultConfig.InitDone)"
                            ]
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(Navigation.OnBack))"
                            ],
                            "value": "Skin.SetString(Navigation.OnBack,Parent)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(CustomRating.Movies.Item01))"
                            ],
                            "value": "Skin.SetString(CustomRating.Movies.Item01,Trakt)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(CustomRating.Movies.Item02))"
                            ],
                            "value": "Skin.SetString(CustomRating.Movies.Item02,Metacritic)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(CustomRating.TVShows.Item01))"
                            ],
                            "value": "Skin.SetString(CustomRating.TVShows.Item01,Trakt)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(CustomRating.TVShows.Item02))"
                            ],
                            "value": "Skin.SetString(CustomRating.TVShows.Item02,Metacritic)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(DialogInfo.Movies.Item01))"
                            ],
                            "value": "Skin.SetString(DialogInfo.Movies.Item01,Trailer)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(DialogInfo.Movies.Item02))"
                            ],
                            "value": "Skin.SetString(DialogInfo.Movies.Item02,Trakt)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(DialogInfo.Movies.Item03))"
                            ],
                            "value": "Skin.SetString(DialogInfo.Movies.Item03,Wikipedia)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(DialogInfo.Others.Item01))"
                            ],
                            "value": "Skin.SetString(DialogInfo.Others.Item01,Trailer)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(DialogInfo.Others.Item02))"
                            ],
                            "value": "Skin.SetString(DialogInfo.Others.Item02,Trakt)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(DialogInfo.Others.Item03))"
                            ],
                            "value": "Skin.SetString(DialogInfo.Others.Item03,Wikipedia)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(HomeSwitcher.Home.Mode))"
                            ],
                            "value": "Skin.SetString(HomeSwitcher.Home.Mode,Standard)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(HomeSwitcher.1101.Mode))"
                            ],
                            "value": "Skin.SetString(HomeSwitcher.1101.Mode,Standard)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(HomeSwitcher.1102.Mode))"
                            ],
                            "value": "Skin.SetString(HomeSwitcher.1102.Mode,Standard)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(HomeSwitcher.1103.Mode))"
                            ],
                            "value": "Skin.SetString(HomeSwitcher.1103.Mode,Standard)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(HomeSwitcher.1104.Mode))"
                            ],
                            "value": "Skin.SetString(HomeSwitcher.1104.Mode,Standard)"
                        }
                    ],
                    [
                        {
                            "rules": [
                                "String.IsEmpty(Skin.String(HomeSwitcher.1108.Mode))"
                            ],
                            "value": "Skin.SetString(HomeSwitcher.1108.Mode,Wall)"
                        }
                    ],
                    "SetProperty(InitStatus,Reticulating Splines,1198)"
                ]
            }
        ],
        "SetProperty(ReloadDone,1)",
        "SetProperty(ReloadDone,1,Home)",
        "sleep=0.5",
        {
            "rules": [
                "!Skin.HasSetting(Startup.DisableWaitForLoad)",
                "System.HasAlarm(SplashTimeOut)",
                "System.HasPVRAddon",
                "!PVR.HasTVChannels",
                "!PVR.HasRadioChannels"
            ],
            "value": [
                "SetProperty(InitStatus,Waiting for PVR,1198)",
                "route=run_executebuiltin=special://skin/shortcuts/skinvariables-startup.json&use_rules=True&var_image_simplebackground={var_image_simplebackground}"
            ]
        },
        "{ReplaceWindowCommand}",
        {
            "rules": [
                "{VideoPath}!="
            ],
            "value": [
                "PlayMedia(\"{VideoPath}\")"
            ]
        }
    ]
}
