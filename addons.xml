<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.fenlight" name="Fen Light" provider-name="Tikipeter" version="3.0.27">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.19.1"/>
        <!-- Pillow, usato dal BlurService. Kodi lo impacchetta nel proprio Python solo sui build
             desktop (macOS/Windows/Linux); su Android (Firestick, Shield) arriva da questo modulo.
             Va comunque dichiarato qui su OGNI piattaforma: Kodi aggiunge un xbmc.python.module al
             sys.path solo degli addon che lo importano esplicitamente. -->
        <import addon="script.module.pil" version="1.1.7"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="resources/lib/fenlight.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="resources/lib/service.py"/>
    <extension point="xbmc.python.module" library="resources/lib/"/>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>false</reuselanguageinvoker>
        <summary lang="en">Access your content from Easynews and Debrid Clouds.</summary>
        <description lang="en">This add-on is intended for advanced Kodi users only. You must own the content of any media you play through this addon. This is an English language only add-on.</description>
        <platform>all</platform>
		<disclaimer lang="en">The author of this addon does not host any of the content which is found and has no affiliation with any of the content providers.</disclaimer>
        <license/>
        <assets>
            <icon>resources/media/fenlight_icon.png</icon>
            <fanart>resources/media/fenlight_fanart2.jpg</fanart>
        </assets>
        <news>INFO: For latest changes see Changelog within Tools of add-on.</news>
    </extension>
</addon>
<addon id="repository.bowserr" name="Bowserr Repo" version="1.1.28" provider-name="Bowserr">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Bowserr Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/bowserrdev/Kodi-Repository/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/bowserrdev/Kodi-Repository/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/bowserrdev/Kodi-Repository/main/</datadir>
            <hashes>true</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Repo privata</summary>
        <description>Sincronizzazione personale dei miei dispositivi</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
